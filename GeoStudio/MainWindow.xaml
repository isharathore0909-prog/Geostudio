<Window x:Class="GeoStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ribbon="clr-namespace:GeoStudio.UI.Views.Ribbon"
        xmlns:sidebar="clr-namespace:GeoStudio.UI.Views.Sidebar"
        mc:Ignorable="d"
        Title="GeoStudio v1.0.0 — Standalone GIS" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Top Chrome & Quick Access Bar -->
            <RowDefinition Height="34"/>
            <!-- 1: Ribbon Tab Navigation Strip -->
            <RowDefinition Height="29"/>
            <!-- 2: Categorized Ribbon Body Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Workspace (Sidebar + Map Canvas) -->
            <RowDefinition Height="*"/>
            <!-- 4: Status Bar -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: RUSTGIS TOP CHROME & QUICK ACCESS BAR                              -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#E2E7ED" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,2,8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand + Quick Access Toolbar -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Document / Project Title -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Command Search Box -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: GIS Icon + GeoStudio Title + Quick Access Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Icons/view_3d.png" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="GeoStudio" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Rectangle Width="1" Fill="#CBD5E1" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <!-- Quick Access Toolbar Buttons -->
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/new_project.png" ToolTip="New Project (Ctrl+N)" Click="MenuNewProject_Click"/>
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/open_project.png" ToolTip="Open Project (Ctrl+O)" Click="MenuOpenProject_Click"/>
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/save_project.png" ToolTip="Save Project (Ctrl+S)" Click="MenuSaveProject_Click"/>
                    <Rectangle Width="1" Fill="#CBD5E1" Height="14" Margin="4,0,4,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/undo.png" ToolTip="Undo (Ctrl+Z)" Click="BtnUndo_Click"/>
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/redo.png" ToolTip="Redo (Ctrl+Y)" Click="BtnRedo_Click"/>
                </StackPanel>

                <!-- Center: Project Title -->
                <TextBlock Grid.Column="1" Text="World Atlas — World Map" FontSize="11.5" Foreground="#64748B" 
                           FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Right: Command Search Bar -->
                <Border Grid.Column="2" Width="230" Height="24" Background="#FFFFFF" BorderBrush="#CBD5E1" 
                        BorderThickness="1" CornerRadius="4" Padding="6,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="CommandSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                 FontSize="11" Foreground="#1E293B" VerticalAlignment="Center"
                                 GotFocus="CommandSearch_GotFocus" LostFocus="CommandSearch_LostFocus"/>
                        <TextBlock x:Name="SearchWatermark" Grid.Column="1" Text="Command Search" FontSize="11" Foreground="#94A3B8" 
                                   IsHitTestVisible="False" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+K" FontSize="9.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: RUSTGIS RIBBON TABS STRIP                                          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="#E2E7ED" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,1,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <!-- Project Tab (Terracotta Red) -->
                        <RadioButton x:Name="TabProject" Content="Project" Style="{StaticResource RustGisProjectTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Project"/>
                        <!-- Tabs matching RustGIS order -->
                        <RadioButton x:Name="TabHome" Content="Home" Style="{StaticResource RustGisTabRadio}" 
                                     IsChecked="True" Checked="RibbonTab_Checked" Tag="Home"/>
                        <RadioButton x:Name="TabData" Content="Data" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Data"/>
                        <RadioButton x:Name="TabStyle" Content="Style" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Style"/>
                        <RadioButton x:Name="TabEdit" Content="Edit" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Edit"/>
                        <RadioButton x:Name="TabAnalyze" Content="Analyze" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Analyze"/>
                        <RadioButton x:Name="TabView" Content="View" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="View"/>
                        <RadioButton x:Name="TabLidar" Content="LiDAR" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="LiDAR"/>
                        <RadioButton x:Name="TabVector" Content="Vector" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Vector"/>
                        <RadioButton x:Name="TabRaster" Content="Raster" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Raster"/>
                        <RadioButton x:Name="TabSatellite" Content="Satellite" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Satellite"/>
                        <RadioButton x:Name="TabProcessing" Content="Processing" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Processing"/>
                        <RadioButton x:Name="Tab3D" Content="3D" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="3D"/>
                        <RadioButton x:Name="TabSettings" Content="Settings" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Settings"/>
                        <RadioButton x:Name="TabPlugins" Content="Plugins" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Plugins"/>
                        <RadioButton x:Name="TabHelp" Content="Help" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Help"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Ribbon Collapse Button (Right) -->
                <Button x:Name="BtnToggleRibbon" Grid.Column="1" Content="⌃" FontSize="11" FontWeight="Bold" Foreground="#64748B" 
                        Background="Transparent" BorderThickness="0" Width="24" Height="22" Cursor="Hand" ToolTip="Minimize Ribbon"
                        Click="BtnToggleRibbon_Click" Margin="0,0,2,2"/>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: RUSTGIS RIBBON TOOLBAR BODY (CLEAN WHITE AESTHETIC)                -->
        <!-- ========================================================================= -->
        <Border x:Name="RibbonContentBorder" Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="6,3,6,2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <Grid>
                    <ribbon:HomeRibbonView x:Name="RibbonGeneral"/>
                    <ribbon:LayerRibbonView x:Name="RibbonLayer"/>
                    <ribbon:AnalysisRibbonView x:Name="RibbonAnalysis"/>
                    <ribbon:ToolsRibbonView x:Name="RibbonTools"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: MAIN WORKSPACE (SIDEBAR + MAP CANVAS)                              -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Layers Panel -->
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500"/>
                <!-- Splitter -->
                <ColumnDefinition Width="3"/>
                <!-- Central Map Canvas -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <sidebar:LayerSidebarView x:Name="SidebarControl" Grid.Column="0"/>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0" Cursor="SizeWE"/>

            <!-- CENTRAL MAP CANVAS -->
            <Grid Grid.Column="2" Background="#FFFFFF">
                <wv2:WebView2 x:Name="MapWebView" Visibility="Hidden" DefaultBackgroundColor="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Border x:Name="MapLoadingOverlay" Background="#FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 4: STATUS BAR                                                         -->
        <!-- ========================================================================= -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,2">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Coordinate X/Y -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Elev -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Scale -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- CRS -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Active Layer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Status Text -->
                    <ColumnDefinition Width="*"/>
                    <!-- Ready Badge -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="⌖" FontSize="12" Foreground="#3B82F6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCoords" Text="X: —————  Y: —————" FontSize="10.5" Foreground="#334155" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="⛰️" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtElevation" Text="Elev: —————" FontSize="10.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="3" Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtScale" Text="Scale: 1:1" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                </Border>

                <Border Grid.Column="3" Background="#F1F5F9" CornerRadius="3" Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to switch CRS">
                    <TextBlock x:Name="TxtCrs" Text="CRS: EPSG:4326" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtActiveLayer" Text="Layer: None" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="6" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ready" FontSize="10" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
