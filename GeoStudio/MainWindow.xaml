<Window x:Class="GeoStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="GeoStudio v1.0.0 — Standalone GIS" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Search Layers Watermark Style -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Search layers..." Foreground="#94A3B8" FontSize="11"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Layer Item DataTemplate -->
        <DataTemplate x:Key="LayerItemDataTemplate">
            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="6,6" Margin="0,1" Background="#FFFFFF">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Zoom to Layer" Click="BtnZoomToLayer_Click" Tag="{Binding Id}"/>
                        <Separator/>
                        <MenuItem Header="Remove Layer" Click="BtnRemoveLayer_Click" Tag="{Binding Id}" Foreground="#EF4444"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Visibility Checkbox -->
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="LayerCheckBox_Checked" Unchecked="LayerCheckBox_Unchecked" Tag="{Binding Id}"/>

                    <!-- Layer Details & Opacity -->
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center" Background="#2563EB"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E293B" 
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" ToolTip="{Binding Name}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Details}" FontSize="9.5" Foreground="#64748B" Margin="16,2,0,0" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="170" ToolTip="{Binding Details}"/>

                        <!-- Opacity Slider -->
                        <Grid Margin="16,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Opacity:" FontSize="9" Foreground="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Opacity}" 
                                    ValueChanged="LayerOpacity_ValueChanged" Tag="{Binding Id}" SmallChange="0.05" Height="14"/>
                        </Grid>

                        <!-- Load & Canvas Render Duration Pill -->
                        <Border Visibility="{Binding HasLoadTime, Converter={StaticResource BoolToVis}}" 
                                Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="3" 
                                Padding="4,1" Margin="16,3,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱️" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalDurationText}" FontSize="8.5" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                <TextBlock Text=" to canvas" FontSize="8" Foreground="#16A34A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Zoom & Remove Actions -->
                    <Button Grid.Column="2" Content="🔍" FontSize="11" Foreground="#0284C7" Background="Transparent" 
                            BorderThickness="0" Cursor="Hand" Padding="2,2" VerticalAlignment="Top" Margin="2,0"
                            ToolTip="Zoom to Layer" Click="BtnZoomToLayer_Click" Tag="{Binding Id}"/>
                    <Button Grid.Column="3" Content="✕" FontSize="11" Foreground="#EF4444" Background="Transparent" 
                            BorderThickness="0" Cursor="Hand" Padding="2,2" VerticalAlignment="Top"
                            ToolTip="Remove Layer" Click="BtnRemoveLayer_Click" Tag="{Binding Id}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Top Chrome & Quick Access Bar -->
            <RowDefinition Height="34"/>
            <!-- 1: Ribbon Tab Navigation Strip -->
            <RowDefinition Height="29"/>
            <!-- 2: Categorized Ribbon Body Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Workspace (Sidebar + Map Canvas) -->
            <RowDefinition Height="*"/>
            <!-- 4: Status Bar -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: RUSTGIS TOP CHROME & QUICK ACCESS BAR                              -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#E2E7ED" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,2,8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand + Quick Access Toolbar -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Document / Project Title -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Command Search Box -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: GIS Icon + GeoStudio Title + Quick Access Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Icons/view_3d.png" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="GeoStudio" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Rectangle Width="1" Fill="#CBD5E1" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <!-- Quick Access Toolbar Buttons -->
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/new_project.png" ToolTip="New Project (Ctrl+N)" Click="MenuNewProject_Click"/>
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/open_project.png" ToolTip="Open Project (Ctrl+O)" Click="MenuOpenProject_Click"/>
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/save_project.png" ToolTip="Save Project (Ctrl+S)" Click="MenuSaveProject_Click"/>
                    <Rectangle Width="1" Fill="#CBD5E1" Height="14" Margin="4,0,4,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/undo.png" ToolTip="Undo (Ctrl+Z)" Click="BtnUndo_Click"/>
                    <Button Style="{StaticResource RustGisQuickBtn}" Tag="/Resources/Icons/redo.png" ToolTip="Redo (Ctrl+Y)" Click="BtnRedo_Click"/>
                </StackPanel>

                <!-- Center: Project Title -->
                <TextBlock Grid.Column="1" Text="World Atlas — World Map" FontSize="11.5" Foreground="#64748B" 
                           FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Right: Command Search Bar -->
                <Border Grid.Column="2" Width="230" Height="24" Background="#FFFFFF" BorderBrush="#CBD5E1" 
                        BorderThickness="1" CornerRadius="4" Padding="6,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="CommandSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                 FontSize="11" Foreground="#1E293B" VerticalAlignment="Center"
                                 GotFocus="CommandSearch_GotFocus" LostFocus="CommandSearch_LostFocus"/>
                        <TextBlock x:Name="SearchWatermark" Grid.Column="1" Text="Command Search" FontSize="11" Foreground="#94A3B8" 
                                   IsHitTestVisible="False" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+K" FontSize="9.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: RUSTGIS RIBBON TABS STRIP                                          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="#E2E7ED" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,1,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <!-- Project Tab (Terracotta Red) -->
                        <RadioButton x:Name="TabProject" Content="Project" Style="{StaticResource RustGisProjectTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Project"/>
                        <!-- Tabs matching RustGIS order -->
                        <RadioButton x:Name="TabHome" Content="Home" Style="{StaticResource RustGisTabRadio}" 
                                     IsChecked="True" Checked="RibbonTab_Checked" Tag="Home"/>
                        <RadioButton x:Name="TabData" Content="Data" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Data"/>
                        <RadioButton x:Name="TabStyle" Content="Style" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Style"/>
                        <RadioButton x:Name="TabEdit" Content="Edit" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Edit"/>
                        <RadioButton x:Name="TabAnalyze" Content="Analyze" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Analyze"/>
                        <RadioButton x:Name="TabView" Content="View" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="View"/>
                        <RadioButton x:Name="TabLidar" Content="LiDAR" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="LiDAR"/>
                        <RadioButton x:Name="TabVector" Content="Vector" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Vector"/>
                        <RadioButton x:Name="TabRaster" Content="Raster" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Raster"/>
                        <RadioButton x:Name="TabSatellite" Content="Satellite" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Satellite"/>
                        <RadioButton x:Name="TabProcessing" Content="Processing" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Processing"/>
                        <RadioButton x:Name="Tab3D" Content="3D" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="3D"/>
                        <RadioButton x:Name="TabSettings" Content="Settings" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Settings"/>
                        <RadioButton x:Name="TabPlugins" Content="Plugins" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Plugins"/>
                        <RadioButton x:Name="TabHelp" Content="Help" Style="{StaticResource RustGisTabRadio}" 
                                     Checked="RibbonTab_Checked" Tag="Help"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Ribbon Collapse Button (Right) -->
                <Button x:Name="BtnToggleRibbon" Grid.Column="1" Content="⌃" FontSize="11" FontWeight="Bold" Foreground="#64748B" 
                        Background="Transparent" BorderThickness="0" Width="24" Height="22" Cursor="Hand" ToolTip="Minimize Ribbon"
                        Click="BtnToggleRibbon_Click" Margin="0,0,2,2"/>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: RUSTGIS RIBBON TOOLBAR BODY (CLEAN WHITE AESTHETIC)                -->
        <!-- ========================================================================= -->
        <Border x:Name="RibbonContentBorder" Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="6,3,6,2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <Grid>
                    <!-- ============================================================= -->
                    <!-- 1. HOME TAB (RUSTGIS MAIN DASHBOARD)                          -->
                    <!-- ============================================================= -->
                    <StackPanel x:Name="PanelRibbonHome" Orientation="Horizontal" Visibility="Visible">
                        <!-- GROUP: PROJECT -->
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="New&#x0a;Map" Tag="/Resources/Icons/new_project.png" ToolTip="New Project / Map (Ctrl+N)" Click="MenuNewProject_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Toolbox" Tag="/Resources/Icons/control_center.png" ToolTip="Processing Toolbox (Ctrl+Alt+T)" Click="MenuProcessingToolbox_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Import&#x0a;Project" Tag="/Resources/Icons/open_project.png" ToolTip="Open Project (Ctrl+O)" Click="MenuOpenProject_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="New&#x0a;Layout ▾" Tag="/Resources/Icons/print_map.png" ToolTip="Print Map Layout (Ctrl+P)" Click="BtnPrint_Click"/>
                                
                                <!-- Stacked Column: Browser, Add Data, Add Folder -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="3,0,1,0">
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Browser" Tag="/Resources/Icons/browser_panel.png" ToolTip="Open File Browser" Click="BtnFileBrowser_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Add Data ▾" Tag="/Resources/Icons/add_raster.png" ToolTip="Add Layer Data (Ctrl+Shift+R)" Click="BtnAddRaster_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Add Folder" Tag="/Resources/Icons/open_project.png" ToolTip="Connect Folder / Project" Click="MenuOpenProject_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Project" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>

                        <!-- DIVIDER -->
                        <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

                        <!-- GROUP: NAVIGATE -->
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtnActive}" Content="Pan" Tag="/Resources/Icons/pan.png" ToolTip="Pan Tool (P)" Click="BtnPan_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Bookmarks ▾" Tag="/Resources/Icons/map_layout.png" ToolTip="Bookmarks / Spatial Views" Click="BtnZoomFull_Click"/>

                                <!-- Column 1: Full Extent, Zoom In, Zoom Out -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="3,0,1,0">
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Full Extent" Tag="/Resources/Icons/zoom_full.png" ToolTip="Zoom to Full Extent (Ctrl+Shift+F)" Click="BtnZoomFull_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Zoom In" Tag="/Resources/Icons/zoom_in.png" ToolTip="Zoom In (+)" Click="BtnZoomIn_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Zoom Out" Tag="/Resources/Icons/zoom_out.png" ToolTip="Zoom Out (-)" Click="BtnZoomOut_Click"/>
                                </StackPanel>

                                <!-- Column 2: Previous, Next, Go To XY -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="2,0,1,0">
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Previous" Tag="/Resources/Icons/undo.png" ToolTip="Previous Extent" Click="BtnUndo_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Next" Tag="/Resources/Icons/redo.png" ToolTip="Next Extent" Click="BtnRedo_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Go To XY" Tag="/Resources/Icons/coord_capture.png" ToolTip="Coordinate Capture / Go to XY" Click="BtnIdentify_Click"/>
                                </StackPanel>

                                <!-- Column 3: Planar, Identify, Find Place -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="2,0,1,0">
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Planar ▾" Tag="/Resources/Icons/view_3d.png" ToolTip="Map View Mode / 3D Workstation" Click="Btn3dMesh_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Identify ▾" Tag="/Resources/Icons/identify.png" ToolTip="Identify Features (I / F6)" Click="BtnIdentify_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Find Place" Tag="/Resources/Icons/zoom.png" ToolTip="Find / Search Location" Click="BtnZoomFull_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Navigate" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>

                        <!-- DIVIDER -->
                        <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

                        <!-- GROUP: ADD -->
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Basemap ▾" Tag="/Resources/Icons/add_xyz.png" ToolTip="Add OpenStreetMap Basemap" Click="BtnAddOsm_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Add&#x0a;Data ▾" Tag="/Resources/Icons/add_vector.png" ToolTip="Add Vector / Shapefile / GeoJSON (Ctrl+Shift+V)" Click="BtnAddVector_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Web&#x0a;Data ▾" Tag="/Resources/Icons/add_wms.png" ToolTip="Add WMS / WMTS Service" Click="BtnDatabase_Click"/>
                            </StackPanel>
                            <TextBlock Text="Add" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>

                        <!-- DIVIDER -->
                        <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

                        <!-- GROUP: SELECTION -->
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Select" Tag="/Resources/Icons/select.png" ToolTip="Select Feature" Click="BtnSelectPointer_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Select By&#x0a;Attributes" Tag="/Resources/Icons/identify.png" ToolTip="Select by Attributes" Click="BtnIdentify_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Select By&#x0a;Location" Tag="/Resources/Icons/select_poly.png" ToolTip="Select by Polygon / Location" Click="BtnSelectPolygon_Click"/>

                                <!-- Stacked Column: Clear, Zoom To, Attributes -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="3,0,1,0">
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Clear" Tag="/Resources/Icons/clear_selection.png" ToolTip="Clear Selection" Click="BtnClearSelection_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Zoom To" Tag="/Resources/Icons/zoom.png" ToolTip="Zoom to Selected" Click="BtnZoomFull_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Attributes" Tag="/Resources/Icons/identify.png" ToolTip="Attribute Table (F6)" Click="BtnIdentify_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Selection" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>

                        <!-- DIVIDER -->
                        <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

                        <!-- GROUP: INSPECT -->
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Measure ▾" Tag="/Resources/Icons/measure.png" ToolTip="Measure Distance &amp; Area" Click="BtnMeasureDistance_Click"/>

                                <!-- Stacked Column: Locate, Zoom Box, Infographics -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="3,0,1,0">
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Locate" Tag="/Resources/Icons/coord_capture.png" ToolTip="Capture Coordinates" Click="BtnIdentify_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Zoom Box" Tag="/Resources/Icons/zoom_in.png" ToolTip="Select Box Zoom" Click="BtnSelectBox_Click"/>
                                    <Button Style="{StaticResource RustGisSmallBtn}" Content="Profile" Tag="/Resources/Icons/profile.png" ToolTip="Elevation Profile" Click="MenuProfile_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Inspect" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============================================================= -->
                    <!-- 2. PROJECT TAB PANEL (FILE MANAGEMENT)                        -->
                    <!-- ============================================================= -->
                    <StackPanel x:Name="PanelRibbonFile" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="New" Tag="/Resources/Icons/new_project.png" ToolTip="New Project (Ctrl+N)" Click="MenuNewProject_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Open" Tag="/Resources/Icons/open_project.png" ToolTip="Open Project (Ctrl+O)" Click="MenuOpenProject_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Save" Tag="/Resources/Icons/save_project.png" ToolTip="Save Project (Ctrl+S)" Click="MenuSaveProject_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Save As" Tag="/Resources/Icons/save_project_as.png" ToolTip="Save Project As (Ctrl+Shift+S)" Click="MenuSaveProject_Click"/>
                            </StackPanel>
                            <TextBlock Text="Project" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>

                        <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="BigTIFF" Tag="/Resources/Icons/add_raster.png" ToolTip="Load 100GB+ BigTIFF / DEM (Ctrl+Shift+R)" Click="BtnAddRaster_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="LiDAR" Tag="/Resources/Icons/load_las.png" ToolTip="Load LiDAR Point Cloud (LAS/LAZ)" Click="BtnAddLidar_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Vector" Tag="/Resources/Icons/add_vector.png" ToolTip="Load Vector Data (GeoJSON/SHP/GPKG) (Ctrl+Shift+V)" Click="BtnAddVector_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="CSV Points" Tag="/Resources/Icons/add_csv.png" ToolTip="Load Delimited Text (CSV Points)" Click="BtnAddVector_Click"/>
                            </StackPanel>
                            <TextBlock Text="Import Data" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>

                        <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Print Layout" Tag="/Resources/Icons/print_map.png" ToolTip="Print / Export Map Layout (Ctrl+P)" Click="BtnPrint_Click"/>
                            </StackPanel>
                            <TextBlock Text="Print &amp; Export" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>

                        <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Clear Cache" Tag="/Resources/Icons/refresh.png" ToolTip="Clear Cache &amp; Reset Memory" Click="MenuClearCache_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Exit" Tag="/Resources/Icons/delete.png" ToolTip="Exit GeoStudio (Ctrl+Q)" Click="MenuExit_Click"/>
                            </StackPanel>
                            <TextBlock Text="System" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============================================================= -->
                    <!-- 3. DATA TAB PANEL                                             -->
                    <!-- ============================================================= -->
                    <StackPanel x:Name="PanelRibbonData" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Vector" Tag="/Resources/Icons/add_vector.png" ToolTip="Add Vector Layer (Ctrl+Shift+V)" Click="BtnAddVector_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Raster / DEM" Tag="/Resources/Icons/add_raster.png" ToolTip="Add 100GB+ BigTIFF / Raster (Ctrl+Shift+R)" Click="BtnAddRaster_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="LiDAR" Tag="/Resources/Icons/load_las.png" ToolTip="Add LiDAR Point Cloud (LAS/LAZ)" Click="BtnAddLidar_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="OSM Basemap" Tag="/Resources/Icons/add_xyz.png" ToolTip="Add OpenStreetMap XYZ Basemap" Click="BtnAddOsm_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="WMS / WMTS" Tag="/Resources/Icons/add_wms.png" ToolTip="Add WMS / WMTS Basemap Layer" Click="BtnDatabase_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="File Browser" Tag="/Resources/Icons/browser_panel.png" ToolTip="Browse Local Files / Layers Panel" Click="BtnFileBrowser_Click"/>
                            </StackPanel>
                            <TextBlock Text="Data Sources" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>

