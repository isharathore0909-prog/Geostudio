                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="Docs" Tag="/Resources/Icons/browser_panel.png" ToolTip="GeoStudio Documentation" Click="MenuDocs_Click"/>
                                <Button Style="{StaticResource RustGisLargeBtn}" Content="About" Tag="/Resources/Icons/control_center.png" ToolTip="About GeoStudio Standalone GIS" Click="MenuAbout_Click"/>
                            </StackPanel>
                            <TextBlock Text="Help &amp; Support" Style="{StaticResource RustGisGroupLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: MAIN WORKSPACE (SIDEBAR + MAP CANVAS)                              -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Layers Panel -->
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500"/>
                <!-- Splitter -->
                <ColumnDefinition Width="3"/>
                <!-- Central Map Canvas -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="34"/>
                        <!-- Layers Root & Search -->
                        <RowDefinition Height="Auto"/>
                        <!-- Layer Items List -->
                        <RowDefinition Height="*"/>
                        <!-- Quick Add Buttons -->
                        <RowDefinition Height="46"/>
                        <!-- Live Telemetry & Hardware Resource Panel -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC" Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="Layers" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Dock / Options">
                                <TextBlock Text="⧉" FontSize="13" Foreground="#64748B"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Layers Root & Search -->
                    <StackPanel Grid.Row="1" Margin="8,8,8,4">
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="LAYERS" FontWeight="Bold" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#E2E8F0" CornerRadius="10" Padding="8,1">
                                    <TextBlock x:Name="TxtLayerCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Search Layers Input -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSearchLayers" Grid.Column="1" BorderThickness="0" Background="Transparent" 
                                         FontSize="11" VerticalAlignment="Center" TextChanged="TxtSearchLayers_TextChanged"
                                         Style="{StaticResource SearchTextBoxStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Layer Items List (Uses extracted LayerItemDataTemplate resource) -->
                    <ScrollViewer Grid.Row="2" Margin="6,2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LayersListControl" ItemTemplate="{StaticResource LayerItemDataTemplate}"/>
                    </ScrollViewer>

                    <!-- Bottom Quick-Add Buttons: Vector, Raster / DEM, OSM -->
                    <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC" Padding="4,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Style="{StaticResource SidebarQuickButtonStyle}" Click="BtnAddVector_Click" ToolTip="Load Vector Data (GeoJSON, SHP)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Vector" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource SidebarQuickButtonStyle}" Click="BtnAddRaster_Click" ToolTip="Load 100GB+ BigTIFF, GeoTIFF, DEM">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⛰️" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Raster / DEM" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource SidebarQuickButtonStyle}" Click="BtnAddOsm_Click" ToolTip="Toggle OpenStreetMap Basemap">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="OSM" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 4: Performance & Live Telemetry Panel -->
                    <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC">
                        <StackPanel Margin="6,5,6,6">
                            <!-- Telemetry Header -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="PERFORMANCE &amp; TELEMETRY" FontSize="9" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="4,1" Margin="0,0,3,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="LiveIndicatorDot" Width="4.5" Height="4.5" Fill="#10B981" Margin="0,0,2.5,0"/>
                                            <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="#059669"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="BtnToggleTelemetry" Content="▾" FontSize="9" FontWeight="Bold" Foreground="#64748B" 
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" Click="BtnToggleTelemetry_Click"
                                            ToolTip="Collapse / Expand Telemetry"/>
                                </StackPanel>
                            </Grid>

                            <!-- Collapsible Content -->
                            <StackPanel x:Name="TelemetryContentPanel">
                                <!-- 1. File Load & Canvas Display Benchmark Card -->
                                <Border x:Name="CardBenchmark" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="5,4" Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtBenchmarkFileName" Text="—" FontWeight="SemiBold" FontSize="10" Foreground="#1E293B" 
                                                           TextTrimming="CharacterEllipsis" MaxWidth="155"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                <TextBlock x:Name="TxtBenchmarkTotalTime" Text="—" FontSize="9.5" FontWeight="Bold" Foreground="#2563EB"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="TxtBenchmarkBreakdown" Text="—" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="ProgressBarFileLoad" Height="2.5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,3,0,2" Foreground="#3B82F6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock x:Name="TxtBenchmarkStatusIcon" Text="✓" FontSize="8.5" Foreground="#10B981" Margin="0,0,3,0" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtBenchmarkStatus" Text="Ready" FontSize="8.5" Foreground="#059669" FontWeight="Medium"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Hardware Resource Metrics: CPU, RAM, GPU -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU Metric Card -->
                                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="4,3" Margin="0,0,2,0">
                                        <StackPanel>
                                            <TextBlock Text="CPU" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtCpuUsage" Text="0.0%" FontSize="10" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,2"/>
                                            <ProgressBar x:Name="ProgressCpu" Height="2" Minimum="0" Maximum="100" Value="0" Foreground="#3B82F6" Background="#F1F5F9" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Memory (RAM) Metric Card -->
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="4,3" Margin="1,0,1,0">
                                        <StackPanel>
                                            <TextBlock Text="MEMORY" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtMemoryUsage" Text="— MB" FontSize="10" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,2"/>
                                            <TextBlock x:Name="TxtMemoryPeak" Text="RAM Active" FontSize="7.5" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU & WebGL Canvas Metric Card -->
                                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="4,3" Margin="2,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="GPU CANVAS" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtGpuFps" Text="60 FPS" FontSize="10" FontWeight="Bold" Foreground="#10B981" Margin="0,1,0,2"/>
                                            <TextBlock x:Name="TxtGpuFrameTime" Text="~1.8 ms" FontSize="7.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 3. Interactive Zoom / Pan Telemetry -->
                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="4,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BadgeInteraction" Grid.Column="0" Background="#DBEAFE" CornerRadius="2.5" Padding="3,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtInteractionType" Text="IDLE" FontSize="7.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtInteractionDetails" Text="Zoom: 5.0x • Redraw: 0ms" FontSize="8.5" Foreground="#334155" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtActiveElements" Text="Base Vector / Tiles" FontSize="7.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0" Cursor="SizeWE"/>

            <!-- CENTRAL MAP CANVAS -->
            <Grid Grid.Column="2" Background="#FFFFFF">
                <wv2:WebView2 x:Name="MapWebView" Visibility="Hidden" DefaultBackgroundColor="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Border x:Name="MapLoadingOverlay" Background="#FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 4: STATUS BAR                                                         -->
        <!-- ========================================================================= -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,2">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Coordinate X/Y -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Elev -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Scale -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- CRS -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Active Layer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Status Text -->
                    <ColumnDefinition Width="*"/>
                    <!-- Ready Badge -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="⌖" FontSize="12" Foreground="#3B82F6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCoords" Text="X: —————  Y: —————" FontSize="10.5" Foreground="#334155" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="⛰️" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtElevation" Text="Elev: —————" FontSize="10.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="3" Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtScale" Text="Scale: 1:1" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                </Border>

                <Border Grid.Column="3" Background="#F1F5F9" CornerRadius="3" Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to switch CRS">
                    <TextBlock x:Name="TxtCrs" Text="CRS: EPSG:4326" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtActiveLayer" Text="Layer: None" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="6" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ready" FontSize="10" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
