<Window x:Class="GeoStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="GeoStudio v1.0.0 — Standalone GIS" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Search Layers Watermark Style -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Search layers..." Foreground="#94A3B8" FontSize="11"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Layer Item DataTemplate -->
        <DataTemplate x:Key="LayerItemDataTemplate">
            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="6,6" Margin="0,1" Background="#FFFFFF">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Zoom to Layer" Click="BtnZoomToLayer_Click" Tag="{Binding Id}"/>
                        <Separator/>
                        <MenuItem Header="Remove Layer" Click="BtnRemoveLayer_Click" Tag="{Binding Id}" Foreground="#EF4444"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Visibility Checkbox -->
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="LayerCheckBox_Checked" Unchecked="LayerCheckBox_Unchecked" Tag="{Binding Id}"/>

                    <!-- Layer Details & Opacity -->
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center" Background="#2563EB"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E293B" 
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" ToolTip="{Binding Name}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Details}" FontSize="9.5" Foreground="#64748B" Margin="16,2,0,0" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="170" ToolTip="{Binding Details}"/>

                        <!-- Opacity Slider -->
                        <Grid Margin="16,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Opacity:" FontSize="9" Foreground="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Opacity}" 
                                    ValueChanged="LayerOpacity_ValueChanged" Tag="{Binding Id}" SmallChange="0.05" Height="14"/>
                        </Grid>

                        <!-- Load & Canvas Render Duration Pill -->
                        <Border Visibility="{Binding HasLoadTime, Converter={StaticResource BoolToVis}}" 
                                Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="3" 
                                Padding="4,1" Margin="16,3,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱️" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalDurationText}" FontSize="8.5" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                <TextBlock Text=" to canvas" FontSize="8" Foreground="#16A34A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Zoom & Remove Actions -->
                    <Button Grid.Column="2" Content="🔍" FontSize="11" Foreground="#0284C7" Background="Transparent" 
                            BorderThickness="0" Cursor="Hand" Padding="2,2" VerticalAlignment="Top" Margin="2,0"
                            ToolTip="Zoom to Layer" Click="BtnZoomToLayer_Click" Tag="{Binding Id}"/>
                    <Button Grid.Column="3" Content="✕" FontSize="11" Foreground="#EF4444" Background="Transparent" 
                            BorderThickness="0" Cursor="Hand" Padding="2,2" VerticalAlignment="Top"
                            ToolTip="Remove Layer" Click="BtnRemoveLayer_Click" Tag="{Binding Id}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Menu Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Categorized Ribbon Rows -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Workspace (Sidebar + Map Canvas) -->
            <RowDefinition Height="*"/>
            <!-- 3: Status Bar -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TABBED RIBBON TABS STRIP                                            -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,2,4,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabFile" Content="File" Style="{StaticResource RibbonFileTabRadio}" IsChecked="True" Checked="RibbonTab_Checked" Tag="File"/>
                    <RadioButton x:Name="TabEdit" Content="Edit" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Edit"/>
                    <RadioButton x:Name="TabView" Content="View" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="View"/>
                    <RadioButton x:Name="TabLayer" Content="Layer" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Layer"/>
                    <RadioButton x:Name="TabTerrain" Content="Terrain" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Terrain"/>
                    <RadioButton x:Name="TabLidar" Content="LiDAR" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="LiDAR"/>
                    <RadioButton x:Name="TabVector" Content="Vector" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Vector"/>
                    <RadioButton x:Name="TabRaster" Content="Raster" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Raster"/>
                    <RadioButton x:Name="TabSatellite" Content="Satellite" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Satellite"/>
                    <RadioButton x:Name="TabProcessing" Content="Processing" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Processing"/>
                    <RadioButton x:Name="Tab3D" Content="3D" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="3D"/>
                    <RadioButton x:Name="TabSettings" Content="Settings" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Settings"/>
                    <RadioButton x:Name="TabPlugins" Content="Plugins" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Plugins"/>
                    <RadioButton x:Name="TabHelp" Content="Help" Style="{StaticResource RibbonTabRadio}" Checked="RibbonTab_Checked" Tag="Help"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: CATEGORIZED RESPONSIVE RIBBON TOOLBAR (TAB CONTENT PANELS)           -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,4,4,2">
            <Grid>
                <!-- 1. FILE TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonFile" Orientation="Horizontal" Visibility="Visible">
                    <!-- PROJECT -->
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="New" Tag="/Resources/Icons/new_project.png" ToolTip="New Project (Ctrl+N)" Click="MenuNewProject_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Open" Tag="/Resources/Icons/open_project.png" ToolTip="Open Project (Ctrl+O)" Click="MenuOpenProject_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Save" Tag="/Resources/Icons/save_project.png" ToolTip="Save Project (Ctrl+S)" Click="MenuSaveProject_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Save As" Tag="/Resources/Icons/save_project_as.png" ToolTip="Save Project As (Ctrl+Shift+S)" Click="MenuSaveProject_Click"/>
                            </StackPanel>
                            <TextBlock Text="PROJECT" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- IMPORT / DATA SOURCES -->
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="BigTIFF" Tag="/Resources/Icons/add_raster.png" ToolTip="Load 100GB+ BigTIFF / DEM (Ctrl+Shift+R)" Click="BtnAddRaster_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="LiDAR" Tag="/Resources/Icons/load_las.png" ToolTip="Load LiDAR Point Cloud (LAS/LAZ)" Click="BtnAddLidar_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Vector" Tag="/Resources/Icons/add_vector.png" ToolTip="Load Vector Data (GeoJSON/SHP/GPKG) (Ctrl+Shift+V)" Click="BtnAddVector_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="CSV Points" Tag="/Resources/Icons/add_csv.png" ToolTip="Load Delimited Text (CSV Points)" Click="BtnAddVector_Click"/>
                            </StackPanel>
                            <TextBlock Text="IMPORT DATA" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- PRINT & EXPORT -->
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Print Layout" Tag="/Resources/Icons/print_map.png" ToolTip="Print / Export Map Layout (Ctrl+P)" Click="BtnPrint_Click"/>
                            </StackPanel>
                            <TextBlock Text="PRINT &amp; EXPORT" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- SYSTEM & CACHE -->
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Clear Cache" Tag="/Resources/Icons/refresh.png" ToolTip="Clear Cache &amp; Reset Memory" Click="MenuClearCache_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Exit" Tag="/Resources/Icons/delete.png" ToolTip="Exit GeoStudio (Ctrl+Q)" Click="MenuExit_Click"/>
                            </StackPanel>
                            <TextBlock Text="SYSTEM" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 2. EDIT TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonEdit" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Undo" Tag="/Resources/Icons/undo.png" ToolTip="Undo (Ctrl+Z)" Click="BtnUndo_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Redo" Tag="/Resources/Icons/redo.png" ToolTip="Redo (Ctrl+Y)" Click="BtnRedo_Click"/>
                            </StackPanel>
                            <TextBlock Text="HISTORY" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Clear Select" Tag="/Resources/Icons/clear_selection.png" ToolTip="Clear Selection" Click="BtnClearSelection_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Clear Draw" Tag="/Resources/Icons/delete.png" ToolTip="Clear Digitized Geometries" Click="BtnClearDigitized_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Edit Mode" Tag="/Resources/Icons/toggle_edit.png" ToolTip="Toggle Editing (Ctrl+E)" Click="BtnToggleEdit_Click"/>
                            </StackPanel>
                            <TextBlock Text="SELECTION &amp; EDIT" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Reset Cache" Tag="/Resources/Icons/refresh.png" ToolTip="Clear Cache &amp; Reset Memory" Click="MenuClearCache_Click"/>
                            </StackPanel>
                            <TextBlock Text="MAINTENANCE" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 3. VIEW TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonView" Orientation="Horizontal" Visibility="Collapsed">
                    <!-- NAVIGATION -->
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/pan.png" ToolTip="Pan Map (P)" Click="BtnPan_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/zoom_in.png" ToolTip="Zoom In (+)" Click="BtnZoomIn_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/zoom_out.png" ToolTip="Zoom Out (-)" Click="BtnZoomOut_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/zoom_full.png" ToolTip="Zoom to Full Extent (Ctrl+Shift+F)" Click="BtnZoomFull_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/refresh.png" ToolTip="Refresh Map Canvas (F5)" Click="BtnRefresh_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/swipe.png" ToolTip="Layer Swipe Compare (Ctrl+Shift+W)" Click="BtnSplit_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/blend_mode.png" ToolTip="Blend Mode / Inset Overview" Click="BtnOverview_Click"/>
                            </StackPanel>
                            <TextBlock Text="NAVIGATION" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                    <!-- SELECTION -->
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/identify.png" ToolTip="Identify Features (I / F6)" Click="BtnIdentify_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/select.png" ToolTip="Select Feature" Click="BtnSelectPointer_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/select_rect.png" ToolTip="Select by Rectangle" Click="BtnSelectBox_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/select_poly.png" ToolTip="Select by Polygon" Click="BtnSelectPolygon_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/select_radius.png" ToolTip="Select by Radius / Lasso" Click="BtnSelectRadius_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/clear_selection.png" ToolTip="Clear Selection" Click="BtnClearSelection_Click"/>
                            </StackPanel>
                            <TextBlock Text="SELECTION" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                    <!-- MEASUREMENT -->
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/measure_dist.png" ToolTip="Measure Distance" Click="BtnMeasureDistance_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/measure_area.png" ToolTip="Measure Area" Click="BtnMeasureArea_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/measure_angle.png" ToolTip="Measure Angle / Bearing" Click="BtnMeasureAngle_Click"/>
                            </StackPanel>
                            <TextBlock Text="MEASUREMENT" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 4. LAYER TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonLayer" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Vector" Tag="/Resources/Icons/add_vector.png" ToolTip="Add Vector Layer (Ctrl+Shift+V)" Click="BtnAddVector_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Raster / DEM" Tag="/Resources/Icons/add_raster.png" ToolTip="Add 100GB+ BigTIFF / Raster (Ctrl+Shift+R)" Click="BtnAddRaster_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="LiDAR" Tag="/Resources/Icons/load_las.png" ToolTip="Add LiDAR Point Cloud (LAS/LAZ)" Click="BtnAddLidar_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="OSM Basemap" Tag="/Resources/Icons/add_xyz.png" ToolTip="Add OpenStreetMap XYZ Basemap" Click="BtnAddOsm_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="WMS / WMTS" Tag="/Resources/Icons/add_wms.png" ToolTip="Add WMS / WMTS Basemap Layer" Click="BtnDatabase_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="File Browser" Tag="/Resources/Icons/browser_panel.png" ToolTip="Browse Local Files / Layers Panel" Click="BtnFileBrowser_Click"/>
                            </StackPanel>
                            <TextBlock Text="DATA SOURCES" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Remove Layer" Tag="/Resources/Icons/delete.png" ToolTip="Remove Selected Layer (Ctrl+D)" Click="MenuRemoveLayer_Click"/>
                            </StackPanel>
                            <TextBlock Text="MANAGEMENT" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 5. TERRAIN TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonTerrain" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/Icons/shader.png" Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,1,0"/>
                                <ComboBox x:Name="ComboShader" Width="92" Style="{StaticResource RibbonComboBoxStyle}" SelectionChanged="ComboShader_SelectionChanged">
                                    <ComboBoxItem Content="Shader ▾" IsSelected="True"/>
                                    <ComboBoxItem Content="Atlas (Global Mapper)"/>
                                    <ComboBoxItem Content="Elevation Terrain"/>
                                    <ComboBoxItem Content="Slope Map"/>
                                    <ComboBoxItem Content="Aspect Map"/>
                                    <ComboBoxItem Content="Hillshade"/>
                                    <ComboBoxItem Content="TRI (Ruggedness)"/>
                                    <ComboBoxItem Content="TPI (Position)"/>
                                    <ComboBoxItem Content="TWI (Wetness)"/>
                                    <ComboBoxItem Content="Curvature"/>
                                </ComboBox>
                                <Image Source="/Resources/Icons/elevation.png" Width="18" Height="18" VerticalAlignment="Center" Margin="3,0,1,0"/>
                                <ComboBox x:Name="ComboAtlas" Width="82" Style="{StaticResource RibbonComboBoxStyle}" SelectionChanged="ComboAtlas_SelectionChanged">
                                    <ComboBoxItem Content="Atlas ▾" IsSelected="True"/>
                                    <ComboBoxItem Content="Atlas (Global Mapper)"/>
                                    <ComboBoxItem Content="Terrain (Earth Tones)"/>
                                    <ComboBoxItem Content="Magma"/>
                                    <ComboBoxItem Content="Viridis"/>
                                </ComboBox>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/elevation.png" ToolTip="Elevation Symbology &amp; 3D Relief (Ctrl+Shift+E)" Click="MenuElevation_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/slope.png" ToolTip="Calculate Slope" Click="MenuSlope_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/aspect.png" ToolTip="Calculate Aspect Direction" Click="MenuAspect_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/hillshade.png" ToolTip="3D Hillshade Relief" Click="MenuHillshade_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/profile.png" ToolTip="Elevation Profile Tool" Click="MenuProfile_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/watershed.png" ToolTip="Generate Contour Lines" Click="MenuContour_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/cut_fill.png" ToolTip="Cut / Fill Earthwork Volume" Click="MenuCutFill_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/view_3d.png" ToolTip="Interactive 3D Surface / Viewer" Click="Btn3dMesh_Click"/>
                            </StackPanel>
                            <TextBlock Text="TERRAIN / ELEVATION" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 6. LIDAR TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonLidar" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/load_las.png" ToolTip="Load LAS / LAZ Point Cloud File" Click="BtnAddLidar_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/classify_ground.png" ToolTip="Auto-Classify Ground (SMRF / HAG)" Click="BtnLidarClassifyGround_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/classify_buildings.png" ToolTip="Classify Building Structures" Click="BtnLidarClassifyBuildings_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/classify_veg.png" ToolTip="Classify Vegetation Canopy" Click="BtnLidarClassifyVeg_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/thin.png" ToolTip="Point Density Decimation / Thinning" Click="BtnLidarThin_Click"/>
                                <Image Source="/Resources/Icons/color_by.png" Width="18" Height="18" VerticalAlignment="Center" Margin="3,0,1,0"/>
                                <ComboBox x:Name="ComboLidarColorBy" Width="220" Style="{StaticResource RibbonComboBoxStyle}" SelectionChanged="ComboLidarColorBy_SelectionChanged">
                                    <ComboBoxItem Content="Color By ▾" IsSelected="True"/>
                                    <ComboBoxItem Content="Color Lidar by RGB/Elev"/>
                                    <ComboBoxItem Content="Color Lidar by Elevation"/>
                                    <ComboBoxItem Content="Color Lidar by Intensity"/>
                                    <ComboBoxItem Content="Color Lidar by Classification"/>
                                    <ComboBoxItem Content="Color Lidar by Return Number"/>
                                    <ComboBoxItem Content="Color Lidar by Height Above Ground"/>
                                    <ComboBoxItem Content="Color Lidar by Scan Angle"/>
                                    <ComboBoxItem Content="Color Lidar by Point Source ID"/>
                                    <ComboBoxItem Content="Color Lidar by Source Layer"/>
                                    <ComboBoxItem Content="Color Lidar by Segment"/>
                                    <ComboBoxItem Content="Color Lidar by Point Index"/>
                                    <ComboBoxItem Content="Color Lidar as CIR (Color Infrared)"/>
                                    <ComboBoxItem Content="Color Lidar using NDVI (Vegetation)"/>
                                    <ComboBoxItem Content="Color Lidar using NDWI (Water)"/>
                                    <ComboBoxItem Content="Color Lidar by Point Density"/>
                                    <ComboBoxItem Content="Color Lidar by Withheld Flag"/>
                                    <ComboBoxItem Content="Color Lidar by Key Point Flag"/>
                                    <ComboBoxItem Content="Color Lidar by Overlap Flag"/>
                                    <ComboBoxItem Content="Color Lidar by Return Height Delta"/>
                                    <Separator/>
                                    <ComboBoxItem Content="⚡ Auto-Classify Ground &amp; Canopy (SMRF)..." FontWeight="SemiBold" Foreground="#D97706"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="LIDAR / POINT CLOUD" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Bare DTM" Tag="/Resources/Icons/elevation.png" ToolTip="Generate Bare-Earth DTM" Click="MenuLidarDtm_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="CHM Canopy" Tag="/Resources/Icons/classify_veg.png" ToolTip="Canopy Height Model (CHM)" Click="MenuLidarChm_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="3D Viewer" Tag="/Resources/Icons/view_3d.png" ToolTip="Interactive 3D Point Cloud Workstation" Click="Btn3dMesh_Click"/>
                            </StackPanel>
                            <TextBlock Text="DERIVATIVES &amp; 3D" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 7. VECTOR TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonVector" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/toggle_edit.png" ToolTip="Toggle Vector Editing (Ctrl+E)" Click="BtnToggleEdit_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/add_point.png" ToolTip="Add Point Feature" Click="BtnDigitizePoint_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/add_line.png" ToolTip="Add Line Feature" Click="BtnDigitizeLine_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/add_poly.png" ToolTip="Add Polygon Feature" Click="BtnDigitizePolygon_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/split.png" ToolTip="Split Selected Feature" Click="BtnSplitGeometry_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/delete.png" ToolTip="Delete Selected Features (Delete)" Click="BtnDeleteFeature_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/vertex_tool.png" ToolTip="Vertex Node Editor Tool" Click="BtnVertexTool_Click"/>
                                <Button Style="{StaticResource RibbonIconBtn}" Tag="/Resources/Icons/undo.png" ToolTip="Undo Last Vertex" Click="BtnUndoVertex_Click"/>
                                <Image Source="/Resources/Icons/snapping.png" Width="18" Height="18" VerticalAlignment="Center" Margin="3,0,1,0"/>
                                <ComboBox x:Name="ComboSnapping" Width="92" Style="{StaticResource RibbonComboBoxStyle}" SelectionChanged="ComboSnapping_SelectionChanged">
                                    <ComboBoxItem Content="Snapping ▾" IsSelected="True"/>
                                    <ComboBoxItem Content="Enable Snapping"/>
                                    <ComboBoxItem Content="Snap to Vertices"/>
                                    <ComboBoxItem Content="Snap to Segments"/>
                                    <ComboBoxItem Content="Snap to Area"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="DIGITIZING" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Buffer" Tag="/Resources/Icons/select_radius.png" ToolTip="Geodesic Buffer Geometry..." Click="MenuBuffer_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Convex Hull" Tag="/Resources/Icons/select_poly.png" ToolTip="Calculate Convex Hull" Click="MenuConvexHull_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Centroids" Tag="/Resources/Icons/add_point.png" ToolTip="Calculate Centroids" Click="MenuCentroids_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Voronoi" Tag="/Resources/Icons/select_poly.png" ToolTip="Voronoi Polygons" Click="MenuVoronoi_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Dissolve" Tag="/Resources/Icons/merge.png" ToolTip="Dissolve Boundaries" Click="MenuDissolve_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Attributes" Tag="/Resources/Icons/identify.png" ToolTip="Open Attribute Table (F6)" Click="BtnIdentify_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Clip Vector" Tag="/Resources/Icons/clip.png" ToolTip="Clip Vector Layer by Mask..." Click="MenuClipVector_Click"/>
                            </StackPanel>
                            <TextBlock Text="GEOPROCESSING" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 8. RASTER TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonRaster" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Hillshade" Tag="/Resources/Icons/hillshade.png" ToolTip="Compute 3D Hillshade Relief" Click="MenuHillshade_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Slope" Tag="/Resources/Icons/slope.png" ToolTip="Slope Gradient Analysis" Click="MenuSlope_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Aspect" Tag="/Resources/Icons/aspect.png" ToolTip="Aspect Direction Analysis" Click="MenuAspect_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="TRI" Tag="/Resources/Icons/profile.png" ToolTip="TRI (Terrain Ruggedness Index)" Click="MenuTri_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="TPI" Tag="/Resources/Icons/elevation.png" ToolTip="TPI (Topographic Position Index)" Click="MenuTpi_Click"/>
                            </StackPanel>
                            <TextBlock Text="SURFACE ANALYSIS" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Clip Raster" Tag="/Resources/Icons/clip.png" ToolTip="Crop / Clip Raster by Mask..." Click="MenuClipRaster_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Statistics" Tag="/Resources/Icons/identify.png" ToolTip="Raster Statistics &amp; Histogram" Click="MenuRasterStats_Click"/>
                            </StackPanel>
                            <TextBlock Text="EXTRACTION &amp; STATS" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 9. SATELLITE TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonSatellite" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="NDVI" Tag="/Resources/Icons/classify_veg.png" ToolTip="NDVI (Normalized Difference Vegetation Index)" Click="MenuNdvi_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="NDWI" Tag="/Resources/Icons/add_xyz.png" ToolTip="NDWI (Normalized Difference Water Index)" Click="MenuNdwi_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="EVI" Tag="/Resources/Icons/classify_veg.png" ToolTip="EVI (Enhanced Vegetation Index)" Click="MenuEvi_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="NDBI" Tag="/Resources/Icons/classify_buildings.png" ToolTip="NDBI (Normalized Difference Built-up Index)" Click="MenuNdbi_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="NBR" Tag="/Resources/Icons/shader.png" ToolTip="NBR (Normalized Burn Ratio)" Click="MenuNbr_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="False Color" Tag="/Resources/Icons/color_by.png" ToolTip="False Color RGB Composite..." Click="MenuFalseColor_Click"/>
                            </StackPanel>
                            <TextBlock Text="SPECTRAL INDICES" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 10. PROCESSING TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonProcessing" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Toolbox" Tag="/Resources/Icons/control_center.png" ToolTip="Processing Toolbox (Ctrl+Alt+T)" Click="MenuProcessingToolbox_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Python Console" Tag="/Resources/Icons/configure.png" ToolTip="Python Pipeline Console (Ctrl+Alt+P)" Click="MenuPythonConsole_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Bridge Status" Tag="/Resources/Icons/refresh.png" ToolTip="Python Pipeline Bridge Status" Click="MenuPythonStatus_Click"/>
                            </StackPanel>
                            <TextBlock Text="PROCESSING TOOLS" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 11. 3D TAB PANEL -->
                <WrapPanel x:Name="PanelRibbon3D" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="3D Point Cloud" Tag="/Resources/Icons/view_3d.png" ToolTip="Open 3D Point Cloud Workstation" Click="Btn3dMesh_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="3D Elevation" Tag="/Resources/Icons/elevation.png" ToolTip="3D Elevation Surface Draping" Click="MenuElevation_Click"/>
                            </StackPanel>
                            <TextBlock Text="3D WORKSTATION" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 12. SETTINGS TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonSettings" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="GPU Status" Tag="/Resources/Icons/configure.png" ToolTip="Hardware Budget &amp; GPU Status" Click="MenuGpuStatus_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Purge Cache" Tag="/Resources/Icons/refresh.png" ToolTip="Clear Disk Cache &amp; Reset Memory" Click="MenuClearCache_Click"/>
                            </StackPanel>
                            <TextBlock Text="HARDWARE &amp; PERFORMANCE" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 13. PLUGINS TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonPlugins" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Python Console" Tag="/Resources/Icons/configure.png" ToolTip="Python Pipeline Console (Ctrl+Alt+P)" Click="MenuPythonConsole_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Bridge Status" Tag="/Resources/Icons/refresh.png" ToolTip="Python Pipeline Bridge Status" Click="MenuPythonStatus_Click"/>
                            </StackPanel>
                            <TextBlock Text="PYTHON EXTENSIONS" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 14. HELP TAB PANEL -->
                <WrapPanel x:Name="PanelRibbonHelp" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupCard}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="Docs" Tag="/Resources/Icons/browser_panel.png" ToolTip="GeoStudio Documentation" Click="MenuDocs_Click"/>
                                <Button Style="{StaticResource RibbonLabeledBtn}" Content="About" Tag="/Resources/Icons/control_center.png" ToolTip="About GeoStudio Standalone GIS" Click="MenuAbout_Click"/>
                            </StackPanel>
                            <TextBlock Text="HELP" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: MAIN WORKSPACE (SIDEBAR + MAP CANVAS)                               -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Layers Panel -->
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500"/>
                <!-- Splitter -->
                <ColumnDefinition Width="3"/>
                <!-- Central Map Canvas -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="34"/>
                        <!-- Layers Root & Search -->
                        <RowDefinition Height="Auto"/>
                        <!-- Layer Items List -->
                        <RowDefinition Height="*"/>
                        <!-- Quick Add Buttons -->
                        <RowDefinition Height="46"/>
                        <!-- Live Telemetry & Hardware Resource Panel -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC" Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="Layers" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Dock / Options">
                                <TextBlock Text="⧉" FontSize="13" Foreground="#64748B"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Layers Root & Search -->
                    <StackPanel Grid.Row="1" Margin="8,8,8,4">
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="LAYERS" FontWeight="Bold" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#E2E8F0" CornerRadius="10" Padding="8,1">
                                    <TextBlock x:Name="TxtLayerCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Search Layers Input -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSearchLayers" Grid.Column="1" BorderThickness="0" Background="Transparent" 
                                         FontSize="11" VerticalAlignment="Center" TextChanged="TxtSearchLayers_TextChanged"
                                         Style="{StaticResource SearchTextBoxStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Layer Items List (Uses extracted LayerItemDataTemplate resource) -->
                    <ScrollViewer Grid.Row="2" Margin="6,2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LayersListControl" ItemTemplate="{StaticResource LayerItemDataTemplate}"/>
                    </ScrollViewer>

                    <!-- Bottom Quick-Add Buttons: Vector, Raster / DEM, OSM -->
                    <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC" Padding="4,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Style="{StaticResource SidebarQuickButtonStyle}" Click="BtnAddVector_Click" ToolTip="Load Vector Data (GeoJSON, SHP)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Vector" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource SidebarQuickButtonStyle}" Click="BtnAddRaster_Click" ToolTip="Load 100GB+ BigTIFF, GeoTIFF, DEM">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⛰️" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Raster / DEM" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource SidebarQuickButtonStyle}" Click="BtnAddOsm_Click" ToolTip="Toggle OpenStreetMap Basemap">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="OSM" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 4: Performance & Live Telemetry Panel -->
                    <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC">
                        <StackPanel Margin="6,5,6,6">
                            <!-- Telemetry Header -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="PERFORMANCE &amp; TELEMETRY" FontSize="9" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="4,1" Margin="0,0,3,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="LiveIndicatorDot" Width="4.5" Height="4.5" Fill="#10B981" Margin="0,0,2.5,0"/>
                                            <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="#059669"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="BtnToggleTelemetry" Content="▾" FontSize="9" FontWeight="Bold" Foreground="#64748B" 
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" Click="BtnToggleTelemetry_Click"
                                            ToolTip="Collapse / Expand Telemetry"/>
                                </StackPanel>
                            </Grid>

                            <!-- Collapsible Content -->
                            <StackPanel x:Name="TelemetryContentPanel">
                                <!-- 1. File Load & Canvas Display Benchmark Card -->
                                <Border x:Name="CardBenchmark" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="5,4" Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtBenchmarkFileName" Text="—" FontWeight="SemiBold" FontSize="10" Foreground="#1E293B" 
                                                           TextTrimming="CharacterEllipsis" MaxWidth="155"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                <TextBlock x:Name="TxtBenchmarkTotalTime" Text="—" FontSize="9.5" FontWeight="Bold" Foreground="#2563EB"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="TxtBenchmarkBreakdown" Text="—" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="ProgressBarFileLoad" Height="2.5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,3,0,2" Foreground="#3B82F6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock x:Name="TxtBenchmarkStatusIcon" Text="✓" FontSize="8.5" Foreground="#10B981" Margin="0,0,3,0" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtBenchmarkStatus" Text="Ready" FontSize="8.5" Foreground="#059669" FontWeight="Medium"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Hardware Resource Metrics: CPU, RAM, GPU -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU Metric Card -->
                                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="4,3" Margin="0,0,2,0">
                                        <StackPanel>
                                            <TextBlock Text="CPU" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtCpuUsage" Text="0.0%" FontSize="10" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,2"/>
                                            <ProgressBar x:Name="ProgressCpu" Height="2" Minimum="0" Maximum="100" Value="0" Foreground="#3B82F6" Background="#F1F5F9" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Memory (RAM) Metric Card -->
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="4,3" Margin="1,0,1,0">
                                        <StackPanel>
                                            <TextBlock Text="MEMORY" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtMemoryUsage" Text="— MB" FontSize="10" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,2"/>
                                            <TextBlock x:Name="TxtMemoryPeak" Text="RAM Active" FontSize="7.5" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU & WebGL Canvas Metric Card -->
                                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="4,3" Margin="2,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="GPU CANVAS" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtGpuFps" Text="60 FPS" FontSize="10" FontWeight="Bold" Foreground="#10B981" Margin="0,1,0,2"/>
                                            <TextBlock x:Name="TxtGpuFrameTime" Text="~1.8 ms" FontSize="7.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 3. Interactive Zoom / Pan Telemetry -->
                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="4,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BadgeInteraction" Grid.Column="0" Background="#DBEAFE" CornerRadius="2.5" Padding="3,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtInteractionType" Text="IDLE" FontSize="7.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtInteractionDetails" Text="Zoom: 5.0x • Redraw: 0ms" FontSize="8.5" Foreground="#334155" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtActiveElements" Text="Base Vector / Tiles" FontSize="7.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0" Cursor="SizeWE"/>

            <!-- CENTRAL MAP CANVAS -->
            <Grid Grid.Column="2" Background="#FFFFFF">
                <wv2:WebView2 x:Name="MapWebView" Visibility="Hidden" DefaultBackgroundColor="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Border x:Name="MapLoadingOverlay" Background="#FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 3: STATUS BAR                                                         -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,2">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Coordinate X/Y -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Elev -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Scale -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- CRS -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Active Layer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Status Text -->
                    <ColumnDefinition Width="*"/>
                    <!-- Ready Badge -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="⌖" FontSize="12" Foreground="#3B82F6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCoords" Text="X: —————  Y: —————" FontSize="10.5" Foreground="#334155" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="⛰️" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtElevation" Text="Elev: —————" FontSize="10.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="3" Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtScale" Text="Scale: 1:1" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                </Border>

                <Border Grid.Column="3" Background="#F1F5F9" CornerRadius="3" Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to switch CRS">
                    <TextBlock x:Name="TxtCrs" Text="CRS: EPSG:4326" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtActiveLayer" Text="Layer: None" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="6" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
