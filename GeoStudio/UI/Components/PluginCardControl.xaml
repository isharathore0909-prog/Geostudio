<UserControl x:Class="GeoStudio.UI.Components.PluginCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,10">
    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Emoji / Icon Container -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#F1F5F9" 
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{Binding IconEmoji}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 2. Content & Metadata Details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="#0F172A"/>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                    </Border>
                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                        <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Medium" Foreground="#2563EB"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,6" MaxHeight="34" TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦 Size: " FontSize="10" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding DownloadSizeMb, StringFormat='{}{0:F1} MB'}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,0"/>
                    <TextBlock Text="⚙ Engine: " FontSize="10" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding EngineType}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- 3. Status Badge & Action Button -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!-- Status Badge -->
                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Margin="0,0,0,8"
                        Background="#F8FAFC" BorderThickness="1" BorderBrush="#E2E8F0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeColor}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StatusBadgeColor}"/>
                    </StackPanel>
                </Border>

                <!-- Install / Uninstall Button -->
                <Button x:Name="BtnAction" Click="BtnAction_Click" Height="28" Width="105" Cursor="Hand"
                        FontWeight="SemiBold" FontSize="11" Content="{Binding ActionButtonText}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="4,2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#FECACA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
