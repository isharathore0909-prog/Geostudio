<UserControl x:Class="GeoStudio.UI.Components.OutputPathPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="500">
    <StackPanel Margin="0,0,0,10">
        <TextBlock x:Name="TxtLabel" Text="Output Path:" Style="{StaticResource DialogParamLabel}"/>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtPath" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,0" TextChanged="TxtPath_TextChanged"/>
            <Button Grid.Column="1" Content="Save As..." Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource DialogSecondaryButton}" Click="BtnBrowse_Click"/>
        </Grid>

        <TextBlock x:Name="TxtHelper" Text="" FontSize="10" Foreground="#64748B" Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
