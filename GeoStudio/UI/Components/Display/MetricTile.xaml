<UserControl x:Class="GeoStudio.UI.Components.MetricTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="160" d:DesignHeight="70">
    <Border x:Name="BorderContainer" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="4">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TxtLabel" Text="METRIC LABEL" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
            <TextBlock x:Name="TxtValue" Text="--" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
            <TextBlock x:Name="TxtSubtext" Text="" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
