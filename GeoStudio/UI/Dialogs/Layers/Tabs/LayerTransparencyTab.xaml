<UserControl x:Class="GeoStudio.UI.Dialogs.Layers.Tabs.LayerTransparencyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">
    <UserControl.Resources>
        <Style x:Key="QgisParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="QgisExpanderHeader" TargetType="Expander">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
        <StackPanel>
            <Expander Header="Global Opacity" IsExpanded="True" Style="{StaticResource QgisExpanderHeader}">
                <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,4,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkTransparencyVisible" Content="Layer is Visible on Map Canvas" FontSize="11.5" FontWeight="SemiBold" 
                                  Margin="0,0,0,12" Checked="ChkTransparencyVisible_Checked" Unchecked="ChkTransparencyVisible_Unchecked"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Global Opacity:" Style="{StaticResource QgisParamLabel}"/>
                            <Slider Grid.Column="1" x:Name="SliderGlobalOpacity" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" 
                                    ValueChanged="SliderGlobalOpacity_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="TxtGlobalOpacityPercent" Text="100%" FontSize="11" FontWeight="Bold" 
                                       Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#E2E8F0" Margin="0,6,0,10"/>
                        <TextBlock Text="No Data Value Transparency:" Style="{StaticResource QgisParamLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="Pixels matching the NoData flag (e.g., 0 or -9999) are automatically rendered with 0% alpha." FontSize="10.5" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
