<UserControl x:Class="GeoStudio.UI.Dialogs.Layers.Tabs.LayerRenderingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">
    <UserControl.Resources>
        <Style x:Key="QgisParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="QgisExpanderHeader" TargetType="Expander">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="QgisStandardButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
        <StackPanel>
            <Expander Header="Hardware Acceleration &amp; Canvas Options" IsExpanded="True" Style="{StaticResource QgisExpanderHeader}">
                <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,4,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkGpuRendering" Content="⚡ Use GPU Hardware Acceleration" 
                                  FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"
                                  Checked="ChkGpuRendering_Checked" Unchecked="ChkGpuRendering_Unchecked"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resampling" Style="{StaticResource QgisParamLabel}"/>
                            <ComboBox Grid.Column="1" Height="24" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="11" SelectedIndex="0">
                                <ComboBoxItem Content="Nearest Neighbour (Fastest, retains discrete values)"/>
                                <ComboBoxItem Content="Bilinear (Smooth continuous)"/>
                                <ComboBoxItem Content="Cubic (High quality)"/>
                            </ComboBox>
                        </Grid>

                        <Separator Background="#E2E8F0" Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔍 Zoom to Layer Extent" Style="{StaticResource QgisStandardButton}" Click="BtnZoomToLayer_Click" Margin="0,0,8,0"/>
                            <Button Content="✕ Remove Layer" Style="{StaticResource QgisStandardButton}" Foreground="#DC2626" Click="BtnRemoveLayer_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
