<UserControl x:Class="GeoStudio.UI.Dialogs.Layers.Tabs.LayerSymbologyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">
    <UserControl.Resources>
        <Style x:Key="QgisParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="QgisExpanderHeader" TargetType="Expander">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="QgisStandardButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
        <StackPanel>
            <!-- Vector Symbology (QGIS Single Symbol) -->
            <Expander x:Name="ExpanderVectorSymbology" Header="Vector Feature Symbology" IsExpanded="True" Style="{StaticResource QgisExpanderHeader}" Visibility="Collapsed">
                <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,4,0,10">
                    <StackPanel>
                        <!-- Render Type -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Symbol type" Style="{StaticResource QgisParamLabel}"/>
                            <ComboBox Grid.Column="1" x:Name="ComboTabVectorRenderType" Height="24" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="11" SelectionChanged="ComboTabVectorRenderType_SelectionChanged">
                                <ComboBoxItem Content="Single Symbol" Tag="single" IsSelected="True"/>
                                <ComboBoxItem Content="Categorized" Tag="categorized"/>
                                <ComboBoxItem Content="Graduated" Tag="graduated"/>
                                <ComboBoxItem Content="Rule-based" Tag="rule"/>
                                <ComboBoxItem Content="Merged Features" Tag="merged"/>
                                <ComboBoxItem Content="Inverted Polygons" Tag="inverted"/>
                                <ComboBoxItem Content="2.5 D" Tag="2.5d"/>
                                <ComboBoxItem Content="No Symbols" Tag="nosymbol"/>
                            </ComboBox>
                        </Grid>

                        <!-- Fill Color -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Color" Style="{StaticResource QgisParamLabel}"/>
                            <Button Grid.Column="1" x:Name="BtnTabFillColorBar" Height="26" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="4,2" Click="BtnTabPickFill_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" x:Name="SwatchTabFill" Width="34" Height="18" Background="#10B981" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtTabFillHex" Text="#10B981" FontSize="11" Foreground="#334155" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="▾" FontSize="11" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- Fill Opacity -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Opacity" Style="{StaticResource QgisParamLabel}"/>
                            <Slider Grid.Column="1" x:Name="SliderTabFillOpacity" Minimum="0" Maximum="100" Value="28" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="SliderTab_ValueChanged"/>
                            <TextBox Grid.Column="2" Text="{Binding Value, ElementName=SliderTabFillOpacity, StringFormat={}{0:F1}%}" Height="22" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="10.5" IsReadOnly="True" HorizontalContentAlignment="Center"/>
                        </Grid>

                        <!-- Stroke Color -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Stroke" Style="{StaticResource QgisParamLabel}"/>
                            <Button Grid.Column="1" x:Name="BtnTabStrokeColorBar" Height="26" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="4,2" Click="BtnTabPickStroke_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" x:Name="SwatchTabStroke" Width="34" Height="18" Background="#10B981" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtTabStrokeHex" Text="#10B981" FontSize="11" Foreground="#334155" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="▾" FontSize="11" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- Stroke Width -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Width" Style="{StaticResource QgisParamLabel}"/>
                            <Slider Grid.Column="1" x:Name="SliderTabStrokeWidth" Minimum="0.2" Maximum="8.0" Value="1.5" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="SliderTab_ValueChanged"/>
                            <TextBox Grid.Column="2" Text="{Binding Value, ElementName=SliderTabStrokeWidth, StringFormat={}{0:F2} mm}" Height="22" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="10.5" IsReadOnly="True" HorizontalContentAlignment="Center"/>
                        </Grid>

                        <!-- Stroke Style -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Style" Style="{StaticResource QgisParamLabel}"/>
                            <ComboBox Grid.Column="1" x:Name="ComboTabDashStyle" Height="24" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="11" SelectionChanged="ComboTabDashStyle_SelectionChanged">
                                <ComboBoxItem Content="Solid Line" Tag="solid" IsSelected="True"/>
                                <ComboBoxItem Content="Dashed Line" Tag="dashed"/>
                                <ComboBoxItem Content="Dotted Line" Tag="dotted"/>
                            </ComboBox>
                        </Grid>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="Open Full Symbology Studio..." Style="{StaticResource QgisStandardButton}" Click="BtnOpenFullSymbology_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Raster Symbology -->
            <Expander x:Name="ExpanderRasterSymbology" Header="Band Rendering" IsExpanded="True" Style="{StaticResource QgisExpanderHeader}">
                <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,4,0,10">
                    <StackPanel>
                        <!-- Render Type -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Render type" Style="{StaticResource QgisParamLabel}"/>
                            <ComboBox Grid.Column="1" x:Name="ComboRenderType" Height="24" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="11">
                                <ComboBoxItem Content="Paletted/Unique values" Tag="paletted" IsSelected="True"/>
                                <ComboBoxItem Content="Multiband color" Tag="multiband"/>
                                <ComboBoxItem Content="Singleband gray" Tag="gray"/>
                                <ComboBoxItem Content="Singleband pseudocolor" Tag="pseudocolor"/>
                                <ComboBoxItem Content="Hillshade" Tag="hillshade"/>
                            </ComboBox>
                        </Grid>

                        <!-- Color Ramp -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Color ramp" Style="{StaticResource QgisParamLabel}"/>
                            <ComboBox Grid.Column="1" x:Name="ComboColorRamp" Height="24" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="11" SelectionChanged="ComboColorRamp_SelectionChanged">
                                <ComboBoxItem Content="🌿 LULC Intelligence (22 Classes)" Tag="lulc22" IsSelected="True"/>
                                <ComboBoxItem Content="Viridis" Tag="Viridis"/>
                                <ComboBoxItem Content="Spectral" Tag="Spectral"/>
                                <ComboBoxItem Content="Turbo" Tag="Turbo"/>
                                <ComboBoxItem Content="Magma" Tag="Magma"/>
                                <ComboBoxItem Content="Cividis" Tag="Cividis"/>
                                <ComboBoxItem Content="Blues" Tag="Blues"/>
                                <ComboBoxItem Content="Greens" Tag="Greens"/>
                                <ComboBoxItem Content="Reds" Tag="Reds"/>
                                <ComboBoxItem Content="🌍 Dynamic World (9 Classes)" Tag="dw9"/>
                            </ComboBox>
                        </Grid>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Classify" Width="80" Style="{StaticResource QgisStandardButton}" Click="BtnClassify_Click" Margin="0,0,6,0"/>
                            <Button Content="Open Full Symbology Studio..." Style="{StaticResource QgisStandardButton}" Click="BtnOpenFullSymbology_Click"/>
                        </StackPanel>

                        <!-- Classes DataGrid -->
                        <DataGrid x:Name="GridClasses" Height="170" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#FFFFFF"
                                  BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="50" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Color" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="34" Height="14" CornerRadius="2" Background="{Binding ColorHex}" BorderBrush="#94A3B8" BorderThickness="1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
