<UserControl x:Class="GeoStudio.UI.Dialogs.Layers.Tabs.LayerSourceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">
    <UserControl.Resources>
        <Style x:Key="QgisParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="QgisExpanderHeader" TargetType="Expander">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="QgisStandardButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
        <StackPanel>
            <!-- Layer Name -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Layer name" Style="{StaticResource QgisParamLabel}"/>
                <TextBox Grid.Column="1" x:Name="TxtSourceLayerName" Height="24" VerticalContentAlignment="Center" 
                         BorderBrush="#CBD5E1" Background="#FFFFFF" Padding="4,0" FontSize="11"/>
            </Grid>

            <!-- Assigned Coordinate Reference System (CRS) -->
            <Expander Header="Assigned Coordinate Reference System (CRS)" IsExpanded="True" Style="{StaticResource QgisExpanderHeader}">
                <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,4,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="ComboCrs" Height="24" VerticalContentAlignment="Center" 
                                      BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="11">
                                <ComboBoxItem Content="EPSG:32638 - WGS 84 / UTM zone 38N" IsSelected="True"/>
                                <ComboBoxItem Content="EPSG:4326 - WGS 84"/>
                                <ComboBoxItem Content="EPSG:3857 - WGS 84 / Pseudo-Mercator"/>
                                <ComboBoxItem Content="EPSG:32643 - WGS 84 / UTM zone 43N"/>
                                <ComboBoxItem Content="EPSG:32644 - WGS 84 / UTM zone 44N"/>
                                <ComboBoxItem Content="EPSG:32642 - WGS 84 / UTM zone 42N"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="🌐" Height="24" Margin="4,0,0,0" ToolTip="Coordinate Reference System" 
                                    Style="{StaticResource QgisStandardButton}" Padding="0"/>
                        </Grid>

                        <TextBlock Text="Changing this option does not modify the original data source or perform any reprojection of the raster layer. Rather, it can be used to override the layer's CRS within this project if it could not be detected or has been incorrectly detected." 
                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="The Processing &quot;Warp (reproject)&quot; tool should be used to reproject a raster source and permanently change the data source's CRS." 
                                   FontSize="10.5" Foreground="#475569" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Layer Source -->
            <Expander Header="Layer Source" IsExpanded="True" Style="{StaticResource QgisExpanderHeader}">
                <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,4,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtSourcePath" Height="24" VerticalContentAlignment="Center" 
                                 BorderBrush="#CBD5E1" Background="#FFFFFF" Padding="4,0" FontSize="10.5" TextWrapping="NoWrap"/>
                        <Button Grid.Column="1" Content="..." Height="24" Margin="4,0,0,0" ToolTip="Browse for raster layer" 
                                Style="{StaticResource QgisStandardButton}" Click="BtnBrowseSource_Click"/>
                    </Grid>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
