<UserControl x:Class="GeoStudio.UI.Dialogs.Layers.Tabs.LayerHistogramTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">
    <UserControl.Resources>
        <Style x:Key="QgisGreenHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#43A047"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
        <StackPanel>
            <TextBlock Text="Band 1 Frequency Distribution" Style="{StaticResource QgisGreenHeader}"/>
            <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

            <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,4,0,10">
                <StackPanel>
                    <Grid Height="140" Background="#FFFFFF" Margin="0,0,0,10">
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="120">
                                <Border Width="12" Height="25" Background="#3B82F6" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="12" Height="40" Background="#3B82F6" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="12" Height="90" Background="#3B82F6" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="12" Height="110" Background="#2563EB" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="12" Height="75" Background="#3B82F6" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="12" Height="50" Background="#3B82F6" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="12" Height="30" Background="#3B82F6" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="12" Height="15" Background="#3B82F6" Margin="2,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="Min: 0  |  Max: 100  |  Mean: 42.6  |  StdDev: 14.2" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
