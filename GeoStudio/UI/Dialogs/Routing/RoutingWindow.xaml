<Window x:Class="GeoStudio.UI.Dialogs.Routing.RoutingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Road Network Routing &amp; Distance Calculator"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="🚗 Offline Road Network Routing (.NET 8 CSR Engine)" FontWeight="Bold" FontSize="13" Foreground="#312E81"/>
                <TextBlock Text="Calculates high-precision shortest or fastest travel paths across road network graphs 100% offline." FontSize="11" Foreground="#475569" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Inputs -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Start -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Origin (Lng, Lat):" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtStartCoords" Text="75.7873, 26.9124" Margin="0,0,8,10"/>
                <Button Grid.Row="0" Grid.Column="2" Content="📍 Map Click" Height="30" Padding="8,0" Margin="0,0,0,10" Click="BtnPickOrigin_Click" Style="{StaticResource RustGisSmallBtn}"/>

                <!-- Destination -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dest (Lng, Lat):" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtEndCoords" Text="75.8648, 26.9855" Margin="0,0,8,10"/>
                <Button Grid.Row="1" Grid.Column="2" Content="📍 Map Click" Height="30" Padding="8,0" Margin="0,0,0,10" Click="BtnPickDest_Click" Style="{StaticResource RustGisSmallBtn}"/>

                <!-- Optimization Mode -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Route Metric:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RadioShortest" Content="Shortest Distance" IsChecked="True" Margin="0,0,16,0" FontSize="11"/>
                    <RadioButton x:Name="RadioFastest" Content="Fastest Travel Time" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Button -->
        <Button Grid.Row="2" Content="⚡ Compute Optimal Road Route" Height="34" FontWeight="Bold" FontSize="12" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnComputeRoute_Click" Margin="0,0,0,12"/>

        <!-- Results Display -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Route Statistics" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="TxtResultDistance" Text="Total Distance: --" FontSize="12" Foreground="#1E293B" Margin="0,2"/>
                    <TextBlock x:Name="TxtResultDuration" Text="Estimated Duration: --" FontSize="12" Foreground="#1E293B" Margin="0,2"/>
                    <TextBlock x:Name="TxtResultTime" Text="Calculation Time: --" FontSize="11" Foreground="#64748B" Margin="0,2"/>
                    <TextBlock x:Name="TxtStatusMsg" Text="Enter coordinates or click map to route." FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📥 Export Route GeoJSON" HorizontalAlignment="Left" Height="30" Padding="12,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnExportGeoJson_Click"/>
            <Button Grid.Column="1" Content="Draw on Map" Height="30" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnDrawOnMap_Click"/>
            <Button Grid.Column="2" Content="Close" Height="30" Padding="14,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
