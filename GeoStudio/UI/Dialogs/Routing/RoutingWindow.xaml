<Window x:Class="GeoStudio.UI.Dialogs.Routing.RoutingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Road Network Routing &amp; Centroid Distance Calculator"
        Height="460" Width="530"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Inputs Card -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Origin -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Origin (Lng, Lat):" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                    <TextBox Grid.Column="1" x:Name="TxtStartCoords" Text="75.7873, 26.9124" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" x:Name="BtnPickOrigin" Content="📍 Map Click" Height="30" Padding="10,0" Click="BtnPickOrigin_Click" Style="{StaticResource RustGisSmallBtn}"/>
                </Grid>

                <!-- Destination Centroids GeoJSON -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Dest Centroids GeoJSON:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                    <TextBox Grid.Column="1" x:Name="TxtDestGeoJson" Text="" Margin="0,0,8,0" TextChanged="TxtDestGeoJson_TextChanged"/>
                    <Button Grid.Column="2" x:Name="BtnBrowseDest" Content="📂 Browse..." Height="30" Padding="10,0" Click="BtnBrowseDest_Click" Style="{StaticResource RustGisSmallBtn}"/>
                </Grid>

                <!-- Distance Calculations (Checkboxes so both Road and Aerial can be checked) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Calculate:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkRoad" Content="🚗 Road Distance" IsChecked="True" Margin="0,0,16,0" FontSize="11" VerticalAlignment="Center" Checked="CalculateOption_Changed" Unchecked="CalculateOption_Changed"/>
                        <CheckBox x:Name="ChkAerial" Content="✈️ Aerial Distance" IsChecked="True" FontSize="11" VerticalAlignment="Center" Checked="CalculateOption_Changed" Unchecked="CalculateOption_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Road Metric Options -->
                <Grid x:Name="GridRoadMetric" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Road Metric:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RadioShortest" Content="Shortest Distance" IsChecked="True" Margin="0,0,16,0" FontSize="11"/>
                        <RadioButton x:Name="RadioFastest" Content="Fastest Travel Time" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action Button -->
        <Button x:Name="BtnComputeRoute" Grid.Row="1" Content="⚡ Compute Distances &amp; Routes" Height="34" FontWeight="Bold" FontSize="12" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnComputeRoute_Click" Margin="0,0,0,12"/>

        <!-- Results Display -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Route &amp; Distance Statistics" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="TxtResultRoad" Text="Road Distance: --" FontSize="12" Foreground="#1E293B" Margin="0,2"/>
                    <TextBlock x:Name="TxtResultAerial" Text="Aerial Distance: --" FontSize="12" Foreground="#1E293B" Margin="0,2"/>
                    <TextBlock x:Name="TxtResultDuration" Text="Estimated Duration: --" FontSize="11" Foreground="#64748B" Margin="0,2"/>
                    <TextBlock x:Name="TxtResultTime" Text="Calculation Time: --" FontSize="11" Foreground="#64748B" Margin="0,2"/>
                    <TextBlock x:Name="TxtStatusMsg" Text="Pick origin (via Map Click) and select destination centroids GeoJSON." FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📥 Export Route GeoJSON" HorizontalAlignment="Left" Height="30" Padding="12,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnExportGeoJson_Click"/>
            <Button Grid.Column="1" Content="Draw on Map" Height="30" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnDrawOnMap_Click"/>
            <Button Grid.Column="2" Content="Close" Height="30" Padding="14,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
