<Window x:Class="GeoStudio.UI.Dialogs.Hydrology.RechargeBoqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CGWB Recharge Siting &amp; Rajasthan BSR BOQ Estimator"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="💧 CGWB Artificial Recharge Siting &amp; BOQ Cost Engine" FontWeight="Bold" FontSize="13" Foreground="#166534"/>
                <TextBlock Text="Calibrated with official Rajasthan WRD &amp; WDSC BSR 2023-24 rates and CGWB 2007 guidelines." FontSize="11" Foreground="#475569" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Parameters Grid -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Structure Type -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Structure Type:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ComboStructureType" Height="28" SelectionChanged="ComboStructureType_SelectionChanged">
                        <ComboBoxItem Content="Check Dam / Anicut" IsSelected="True"/>
                        <ComboBoxItem Content="Percolation Pond"/>
                        <ComboBoxItem Content="Farm Pond (Khet Talai)"/>
                        <ComboBoxItem Content="Recharge Shaft"/>
                    </ComboBox>
                </StackPanel>

                <!-- Length / Span -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                    <TextBlock x:Name="LblLength" Text="Length / Span (m):" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLength" Text="25.0"/>
                </StackPanel>

                <!-- Height / Depth -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,8">
                    <TextBlock x:Name="LblHeight" Text="Height / Depth (m):" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtHeight" Text="2.5"/>
                </StackPanel>

                <!-- Top Width / Diameter -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                    <TextBlock x:Name="LblWidth" Text="Top Width (m):" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtWidth" Text="1.8"/>
                </StackPanel>

                <!-- Foundation Depth -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Foundation Depth (m):" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtFoundation" Text="1.2"/>
                </StackPanel>

                <!-- Calculate Button -->
                <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Content="⚡ Compute Preliminary BOQ &amp; Cost" Height="28" FontWeight="Bold" FontSize="11" Background="#16A34A" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Margin="0,15,0,0" Click="BtnCompute_Click"/>
            </Grid>
        </Border>

        <!-- BOQ DataGrid -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
            <DataGrid x:Name="GridBoq" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding ItemNo}" Width="35"/>
                    <DataGridTextColumn Header="Item Description (BSR 2023-24)" Binding="{Binding ItemDescription}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat='{}{0:F1}'}" Width="65"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="50"/>
                    <DataGridTextColumn Header="Rate (₹)" Binding="{Binding UnitRateInr, StringFormat='{}{0:N0}'}" Width="75"/>
                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding TotalCostInr, StringFormat='{}{0:N0}'}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Summary & Totals -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStorageCapacity" Text="Est. Storage Capacity: 2.34 TCM (Thousand m³)" FontSize="11" Foreground="#334155"/>
                    <TextBlock Text="Contingency (3%) &amp; Quality Control (2%) included" FontSize="10" Foreground="#64748B"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalCost" Text="Total Cost: ₹ 6,85,400" FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📥 Export BOQ to CSV" HorizontalAlignment="Left" Height="30" Padding="12,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnExportCsv_Click"/>
            <Button Grid.Column="1" Content="Close" Height="30" Padding="16,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
