<Window x:Class="GeoStudio.UI.Dialogs.Hydrology.RechargeBoqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="CGWB Artificial Recharge Master Plan &amp; Rajasthan BSR BOQ Studio"
        Height="730" Width="960"
        MinHeight="620" MinWidth="840"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TabItemHeaderStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Component -->
        <components:DialogHeader Grid.Row="0" Margin="0,0,0,10"
            Icon="💧" IconBrush="#2563EB" IconBg="#EFF6FF"
            Title="CGWB Artificial Recharge Master Plan &amp; Rajasthan BSR BOQ Studio"
            Description="Rajasthan WRD BSR bill of quantities, site-specific recharge siting advisor, and district-level artificial recharge master plan allocation."/>

        <!-- 2. Tabs Container -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#E2E8F0">
            <!-- TAB 1: SITE-SPECIFIC SITING & BOQ (MICRO) -->
            <TabItem Header="📍 Site-Specific Siting &amp; BOQ" Style="{StaticResource TabItemHeaderStyle}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Multi-Criteria Site Inputs Card -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Step 1: Terrain, Stream &amp; Subsurface Site Parameters (CGWB Ch. 5)" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- District -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="District:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="ComboSiteDistrict" SelectionChanged="ComboSiteDistrict_SelectionChanged"/>
                                </StackPanel>

                                <!-- Stream Order -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                                    <TextBlock Text="Stream Order (Strahler):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="ComboSiteStreamOrder">
                                        <ComboBoxItem Content="1st Order (Gully / Ridge)"/>
                                        <ComboBoxItem Content="2nd Order (Small Nala)" IsSelected="True"/>
                                        <ComboBoxItem Content="3rd Order (Main Stream)"/>
                                        <ComboBoxItem Content="4th Order (River Reach)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Channel Bed Width -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,8">
                                    <TextBlock Text="Bed Width (m):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtSiteBedWidth" Text="10.0"/>
                                </StackPanel>

                                <!-- Channel Slope -->
                                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,8,8">
                                    <TextBlock Text="Bed Slope (%):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtSiteSlope" Text="2.0"/>
                                </StackPanel>

                                <!-- Catchment Area -->
                                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,8">
                                    <TextBlock Text="Catchment Area (ha):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtSiteCatchmentArea" Text="65.0"/>
                                </StackPanel>

                                <!-- Lithology -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Lithology / Bed Strata:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="ComboSiteLithology">
                                        <ComboBoxItem Content="Weathered / Fractured Hard Rock" IsSelected="True"/>
                                        <ComboBoxItem Content="Bouldery / Sandy Alluvium"/>
                                        <ComboBoxItem Content="Massive Crystalline Rock"/>
                                        <ComboBoxItem Content="Desert Aeolian Sand"/>
                                        <ComboBoxItem Content="Sandstone / Limestone Outcrop"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Post-Monsoon DTW -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Post-Monsoon DTW (m):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtSiteDtw" Text="11.5"/>
                                </StackPanel>

                                <!-- Native EC -->
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Native EC (µS/cm):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtSiteEc" Text="1200"/>
                                </StackPanel>

                                <!-- Catchment Type -->
                                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Catchment Type:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="ComboSiteCatchmentType">
                                        <ComboBoxItem Content="Average (C ≈ 0.16)" IsSelected="True"/>
                                        <ComboBoxItem Content="Good (Steep/Rocky C ≈ 0.22)"/>
                                        <ComboBoxItem Content="Bad (Flat/Sandy C ≈ 0.10)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Evaluate Button -->
                                <Button Grid.Row="1" Grid.Column="4" Content="⚡ Siting Advisor" Style="{StaticResource DialogActionButton}" Height="30" VerticalAlignment="Bottom" Click="BtnEvaluateSite_Click"/>
                            </Grid>

                            <!-- Checkboxes for exceptions -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox x:Name="ChkClayCover" Content="Upper 3-8m has low-permeability clay blanket over aquifer" FontSize="11" Foreground="#334155" Margin="0,0,20,0"/>
                                <CheckBox x:Name="ChkOutcropWest" Content="Sandstone/Limestone outcrop generating runoff (Western Zone)" FontSize="11" Foreground="#334155"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Siting Verdict Banner -->
                    <Border Grid.Row="1" x:Name="BorderSitingVerdict" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtSitingVerdict" Text="RECOMMENDED: Pacca Masonry Check Dam (Order 2-3)" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                                <TextBlock x:Name="TxtSitingReason" Text="Stream order 2 nala with firm rocky bed/banks (width 5-15m, slope 1-3%). Pondage recharges phreatic aquifer directly." FontSize="11" Foreground="#1E3A8A" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCatchmentYield" Text="Est. Catchment Yield: 64.5 TCM | 4 Fillings" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Structure Dimensions & BOQ Parameters Grid -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sizing Controls -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Structure Type -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Structure Type:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="ComboStructureType" Height="30" SelectionChanged="ComboStructureType_SelectionChanged">
                                        <ComboBoxItem Content="Check Dam (Pacca Masonry)" IsSelected="True"/>
                                        <ComboBoxItem Content="Percolation Tank / Talab"/>
                                        <ComboBoxItem Content="Farm Pond (Khet Talai)"/>
                                        <ComboBoxItem Content="Mini Percolation Tank"/>
                                        <ComboBoxItem Content="Anicut (Spillway &amp; Apron)"/>
                                        <ComboBoxItem Content="Recharge Shaft (Injection Bore)"/>
                                        <ComboBoxItem Content="Tanka (Rainwater Cistern)"/>
                                        <ComboBoxItem Content="Macro Storage Tank"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Length -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock x:Name="LblLength" Text="Length / Span (m):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtLength" Text="25.0"/>
                                </StackPanel>

                                <!-- Height -->
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock x:Name="LblHeight" Text="Weir Height (m):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtHeight" Text="2.5"/>
                                </StackPanel>

                                <!-- Width -->
                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock x:Name="LblWidth" Text="Top Width (m):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtWidth" Text="1.8"/>
                                </StackPanel>

                                <!-- Foundation Depth -->
                                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                    <TextBlock x:Name="LblFoundation" Text="Foundation Depth (m):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtFoundation" Text="1.2"/>
                                </StackPanel>

                                <!-- Calculate BOQ Button -->
                                <Button Grid.Column="5" Content="⚡ Recalculate BOQ" Style="{StaticResource DialogActionButton}" Height="30" Padding="14,0" VerticalAlignment="Bottom" Click="BtnCompute_Click"/>
                            </Grid>
                        </Border>

                        <!-- BOQ DataGrid -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                            <DataGrid x:Name="GridBoq" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding ItemNo}" Width="35"/>
                                    <DataGridTextColumn Header="Item Description (Rajasthan WRD BSR 2023-24)" Binding="{Binding ItemDescription}" Width="*"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat='{}{0:F1}'}" Width="70"/>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="50"/>
                                    <DataGridTextColumn Header="Rate (₹)" Binding="{Binding UnitRateInr, StringFormat='{}{0:N0}'}" Width="85"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding TotalCostInr, StringFormat='{}{0:N0}'}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Totals Banner -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStorageCapacity" Text="Est. Storage Capacity: 2.34 TCM (Thousand m³)" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text="Includes 3% Contingency &amp; 2% Quality Control supervision" FontSize="10.5" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTotalCost" Text="Total Cost: ₹ 14,04,714" FontSize="14.5" FontWeight="Bold" Foreground="#1E40AF"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Export button -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="📥 Export Site BOQ to CSV" Style="{StaticResource DialogSecondaryButton}" Height="30" Padding="14,0" Click="BtnExportCsv_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: CGWB MASTER PLAN ALLOCATOR (MACRO) -->
            <TabItem Header="🗺️ CGWB Master Plan Allocator" Style="{StaticResource TabItemHeaderStyle}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- District & Policy Selection -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Rajasthan District Profile &amp; Baseline Hydrogeology (Table 8.17.1)" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- District -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="District:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="ComboMacroDistrict" SelectionChanged="ComboMacroDistrict_SelectionChanged"/>
                                </StackPanel>

                                <!-- Extraction Stage -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Stage of Extraction:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="ComboMacroStage">
                                        <ComboBoxItem Content="Over-Exploited (>100%)" IsSelected="True"/>
                                        <ComboBoxItem Content="Critical (90-100%)"/>
                                        <ComboBoxItem Content="Semi-Critical (70-90%)"/>
                                        <ComboBoxItem Content="Safe (&lt;70% - CAT Only)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- DTW -->
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Post-Mon DTW (m):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtMacroDtw" Text="12.0"/>
                                </StackPanel>

                                <!-- Trend -->
                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Trend (m/yr):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtMacroTrend" Text="-0.42"/>
                                </StackPanel>

                                <!-- EC -->
                                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                    <TextBlock Text="EC (µS/cm):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtMacroEc" Text="1250"/>
                                </StackPanel>

                                <!-- Specific Yield Sy -->
                                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                    <TextBlock Text="Specific Yield (%):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtMacroSy" Text="2.2"/>
                                </StackPanel>

                                <!-- Surplus Runoff -->
                                <StackPanel Grid.Column="6" Margin="0,0,8,0">
                                    <TextBlock Text="Surplus Runoff (MCM):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtMacroSurplus" Text="285.0"/>
                                </StackPanel>

                                <!-- Calculate Button -->
                                <Button Grid.Column="7" Content="⚡ Compute Plan" Style="{StaticResource DialogActionButton}" Height="30" Padding="14,0" VerticalAlignment="Bottom" Click="BtnComputeMacro_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Water Balance & Volume Metrics -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Status remark -->
                            <TextBlock Grid.Row="0" x:Name="TxtMacroScreeningRemark" Text="Screening Status: Eligible for full artificial recharge master plan allocation." FontWeight="SemiBold" FontSize="11.5" Foreground="#1E40AF" Margin="0,0,0,8"/>

                            <!-- Metric Pills -->
                            <UniformGrid Grid.Row="1" Columns="6">
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Unsat. T (DTW - 3m)" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtMacroT" Text="9.0 m" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Unsat. Volume (Vu)" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtMacroVu" Text="94,095 MCM" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Storage Space (Vu×Sy)" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtMacroSpace" Text="2,070 MCM" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Water Required (/0.75)" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtMacroWaterReq" Text="2,760 MCM" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Surplus Available" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtMacroSurplusVal" Text="285 MCM" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="Feasible Recharge" FontSize="9.5" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                        <TextBlock x:Name="TxtMacroFeasible" Text="285 MCM" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Quota & Budget Grid -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                        <DataGrid x:Name="GridMacroQuota" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Structure Type / Intervention" Binding="{Binding StructureType}" Width="*"/>
                                <DataGridTextColumn Header="Target Quota (Units / Ha)" Binding="{Binding Count, StringFormat='{}{0:N0}'}" Width="150"/>
                                <DataGridTextColumn Header="Unit Cost (₹ Lakh)" Binding="{Binding UnitCostLakhs, StringFormat='{}{0:F1}'}" Width="120"/>
                                <DataGridTextColumn Header="Total Cost (₹ Crore)" Binding="{Binding TotalCostCrores, StringFormat='{}{0:F2}'}" Width="130"/>
                                <DataGridTextColumn Header="Applicable Zone / Siting" Binding="{Binding ApplicableRegion}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Master Plan Footer Budget -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📥 Export Master Plan Allocation to CSV" Style="{StaticResource DialogSecondaryButton}" Height="30" Padding="14,0" Click="BtnExportMacroCsv_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMacroTotalBudget" Text="Estimated District Outlay: ₹ 482.50 Cr" FontSize="14.5" FontWeight="Bold" Foreground="#1E40AF"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. Window Bottom Close -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Close" HorizontalAlignment="Right" Height="32" Padding="20,0" Style="{StaticResource DialogSecondaryButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>