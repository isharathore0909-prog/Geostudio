<Window x:Class="GeoStudio.UI.Dialogs.Hydrology.CropWaterPlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="Water-Budget Crop &amp; Horticulture Planning"
        Height="540" Width="620"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Component -->
        <components:DialogHeader Grid.Row="0" Margin="0,0,0,12"
            Icon="🌾" IconBrush="#2563EB" IconBg="#EFF6FF"
            Title="Water-Budget Crop &amp; Horticulture Planning"
            Description="Calibrates climate-resilient crop prescriptions and pressurized micro-irrigation systems against CGWB groundwater availability and aquifer potential."/>

        <!-- 2. Inputs Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Annual Rainfall (mm):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRainfall" Text="450"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                    <TextBlock Text="Aquifer Lithology Type:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboAquifer">
                        <ComboBoxItem Content="Alluvium (Older/Younger)" IsSelected="True"/>
                        <ComboBoxItem Content="Sandstone / Limestone"/>
                        <ComboBoxItem Content="Hard Rock (Gneiss / Schist)"/>
                        <ComboBoxItem Content="Basalt (Deccan Trap)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,0">
                    <TextBlock Text="CGWB Groundwater Exploitation Status:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboGwStatus">
                        <ComboBoxItem Content="Safe (&lt; 70% draft)"/>
                        <ComboBoxItem Content="Semi-Critical (70-90%)" IsSelected="True"/>
                        <ComboBoxItem Content="Critical (90-100%)"/>
                        <ComboBoxItem Content="Over-Exploited (&gt; 100%)"/>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Row="1" Grid.Column="2" Content="⚡ Generate Plan" Style="{StaticResource DialogActionButton}" Height="30" VerticalAlignment="Bottom" Click="BtnGeneratePlan_Click"/>
            </Grid>
        </Border>

        <!-- 3. Results Display Card -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <ScrollViewer x:Name="ScrollResults" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelResults">
                    <TextBlock Text="Recommended Crop Prescriptions" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,10"/>

                    <TextBlock Text="Kharif Season (Monsoon):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,2"/>
                    <TextBlock x:Name="TxtKharif" Text="• Bajra, Moong, Cluster Bean (Guar)" FontSize="11.5" Foreground="#475569" Margin="10,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock Text="Rabi Season (Winter):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,2"/>
                    <TextBlock x:Name="TxtRabi" Text="• Mustard (Low water), Gram (Chickpea)" FontSize="11.5" Foreground="#475569" Margin="10,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock Text="High-Value Horticulture / Fruit:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,2"/>
                    <TextBlock x:Name="TxtHorticulture" Text="• Pomegranate (Bhagwa), Ber, Aonla" FontSize="11.5" Foreground="#475569" Margin="10,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock Text="Commercial Vegetables (Micro-Drip):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,2"/>
                    <TextBlock x:Name="TxtVegetables" Text="• Garlic, Chilli, Coriander" FontSize="11.5" Foreground="#475569" Margin="10,0,0,10" TextWrapping="Wrap"/>

                    <!-- Irrigation callout container -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Prescribed Irrigation &amp; Water Conveyance:" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtIrrigation" Text="• Pressurized Sprinkler + Underground PVC Piped Distribution" FontSize="11.5" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 4. Footer -->
        <Grid Grid.Row="3">
            <Button Content="Close" HorizontalAlignment="Right" Height="32" Padding="20,0" Style="{StaticResource DialogSecondaryButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>