<Window x:Class="GeoStudio.UI.Dialogs.Raster.LandsatLstWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Landsat Calibration &amp; Split-Window LST (Thermal)"
        Height="500" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🌡️ USGS Landsat Collection 2 L1 &amp; Split-Window LST" FontWeight="Bold" FontSize="13" Foreground="#92400E"/>
                <TextBlock Text="Scales digital numbers to TOA Radiance, Reflectance, Brightness Temp and Du/Sobrino Split-Window LST." FontSize="11" Foreground="#475569" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- File Pickers -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MTL File -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Metadata (MTL.txt):" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMtlPath" Margin="0,0,8,8"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Height="28" Padding="10,0" Margin="0,0,0,8" Style="{StaticResource RustGisSmallBtn}" Click="BtnBrowseMtl_Click"/>

                <!-- Thermal Band 10 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="TIRS Band 10:" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtB10Path" Margin="0,0,8,8"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Height="28" Padding="10,0" Margin="0,0,0,8" Style="{StaticResource RustGisSmallBtn}" Click="BtnBrowseB10_Click"/>

                <!-- Thermal Band 11 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="TIRS Band 11:" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtB11Path" Margin="0,0,8,8"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Height="28" Padding="10,0" Margin="0,0,0,8" Style="{StaticResource RustGisSmallBtn}" Click="BtnBrowseB11_Click"/>

                <!-- Execute Button & Progress -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                    <Button x:Name="BtnRunCalibration" Content="⚡ Run Calibration &amp; Split-Window LST" Height="32" FontWeight="Bold" FontSize="12" Background="#D97706" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnRunCalibration_Click"/>
                    <ProgressBar x:Name="ProgressBarLst" Height="4" Margin="0,6,0,0" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results / Diagnostics -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Calibration &amp; Temperature Diagnostics" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtReport" Text="Select Landsat MTL.txt and click Run to calculate calibration metrics." FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Button Content="Close" HorizontalAlignment="Right" Height="30" Padding="16,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
