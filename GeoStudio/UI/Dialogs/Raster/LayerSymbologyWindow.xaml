<Window x:Class="GeoStudio.UI.Dialogs.Raster.LayerSymbologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layer Symbology" Height="700" Width="680" MinHeight="520" MinWidth="580"
        WindowStartupLocation="CenterOwner" Background="#F0F0F0" Foreground="#1E293B"
        FontFamily="Segoe UI" FontSize="11.5" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="QgisExpanderHeader" TargetType="Expander">
            <Setter Property="Foreground" Value="#0F172A"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="QgisParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="QgisTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="24"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Padding" Value="4,0"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="QgisComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="QgisButton" TargetType="Button">
            <Setter Property="Height" Value="24"/><Setter Property="Padding" Value="8,0"/><Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10,8,10,10">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel Orientation="Vertical">

                <!-- 1. BAND RENDERING SECTION (Exact QGIS 7 Modes) -->
                <Expander Header="Band Rendering" IsExpanded="True" Style="{StaticResource QgisExpanderHeader}">
                    <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,4,0,8">
                        <StackPanel>
                            <!-- Render Type Dropdown (Exact QGIS List) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Render type" Style="{StaticResource QgisParamLabel}"/>
                                <ComboBox Grid.Column="1" x:Name="ComboRenderType" Style="{StaticResource QgisComboBox}" SelectionChanged="ComboRenderType_SelectionChanged">
                                    <ComboBoxItem Content="Multiband color" Tag="multiband"/>
                                    <ComboBoxItem Content="Paletted/Unique values" Tag="paletted" IsSelected="True"/>
                                    <ComboBoxItem Content="Singleband gray" Tag="gray"/>
                                    <ComboBoxItem Content="Singleband pseudocolor" Tag="pseudocolor"/>
                                    <ComboBoxItem Content="Single color" Tag="singlecolor"/>
                                    <ComboBoxItem Content="Hillshade" Tag="hillshade"/>
                                    <ComboBoxItem Content="Contours" Tag="contours"/>
                                </ComboBox>
                            </Grid>

                            <!-- 1A. Multiband Color Panel -->
                            <StackPanel x:Name="PanelMultiband" Visibility="Collapsed">
                                <Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Red band" Style="{StaticResource QgisParamLabel}"/><ComboBox Grid.Column="1" x:Name="ComboRedBand" Style="{StaticResource QgisComboBox}"/>
                                </Grid>
                                <Grid Margin="100,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Min" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="1" x:Name="TxtRedMin" Text="0" Style="{StaticResource QgisTextBox}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="Max" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="3" x:Name="TxtRedMax" Text="255" Style="{StaticResource QgisTextBox}"/>
                                </Grid>
                                <Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Green band" Style="{StaticResource QgisParamLabel}"/><ComboBox Grid.Column="1" x:Name="ComboGreenBand" Style="{StaticResource QgisComboBox}"/>
                                </Grid>
                                <Grid Margin="100,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Min" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="1" x:Name="TxtGreenMin" Text="0" Style="{StaticResource QgisTextBox}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="Max" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="3" x:Name="TxtGreenMax" Text="255" Style="{StaticResource QgisTextBox}"/>
                                </Grid>
                                <Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Blue band" Style="{StaticResource QgisParamLabel}"/><ComboBox Grid.Column="1" x:Name="ComboBlueBand" Style="{StaticResource QgisComboBox}"/>
                                </Grid>
                                <Grid Margin="100,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Min" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="1" x:Name="TxtBlueMin" Text="0" Style="{StaticResource QgisTextBox}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="Max" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="3" x:Name="TxtBlueMax" Text="255" Style="{StaticResource QgisTextBox}"/>
                                </Grid>
                            </StackPanel>

                            <!-- 1B. Paletted / Unique Values Panel (Exact QGIS Color Ramps) -->
                            <StackPanel x:Name="PanelPaletted" Visibility="Visible">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Color ramp" Style="{StaticResource QgisParamLabel}"/>
                                    <ComboBox Grid.Column="1" x:Name="ComboColorRamp" Style="{StaticResource QgisComboBox}" Margin="0,0,6,0" SelectionChanged="ComboColorRamp_SelectionChanged">
                                        <ComboBoxItem Content="Viridis" Tag="Viridis" IsSelected="True"/>
                                        <ComboBoxItem Content="Spectral" Tag="Spectral"/>
                                        <ComboBoxItem Content="Turbo" Tag="Turbo"/>
                                        <ComboBoxItem Content="Magma" Tag="Magma"/>
                                        <ComboBoxItem Content="Cividis" Tag="Cividis"/>
                                        <ComboBoxItem Content="Blues" Tag="Blues"/>
                                        <ComboBoxItem Content="Greens" Tag="Greens"/>
                                        <ComboBoxItem Content="Reds" Tag="Reds"/>
                                        <ComboBoxItem Content="Greys" Tag="Greys"/>
                                        <ComboBoxItem Content="Mako" Tag="Mako"/>
                                        <ComboBoxItem Content="Rocket" Tag="Rocket"/>
                                        <ComboBoxItem Content="RdGy" Tag="RdGy"/>
                                        <ComboBoxItem Content="🌿 LULC Intelligence (22 Classes)" Tag="lulc22"/>
                                        <ComboBoxItem Content="🌍 Dynamic World (9 Classes)" Tag="dw9"/>
                                        <ComboBoxItem Content="🎲 Random Color Ramp" Tag="random"/>
                                    </ComboBox>
                                    <CheckBox Grid.Column="2" x:Name="ChkInvertRamp" Content="Invert" VerticalAlignment="Center" Margin="0,0,6,0" Click="ChkInvertRamp_Click"/>
                                    <Button Grid.Column="3" Content="⚡ Classify" Style="{StaticResource QgisButton}" Click="BtnScanClasses_Click"/>
                                </Grid>

                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Background="#FFFFFF" MaxHeight="190">
                                    <DataGrid x:Name="GridClasses" AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F1F5F9" RowHeight="24" FontSize="11" BorderThickness="0" Background="#FFFFFF">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Show" Binding="{Binding IsVisible}" Width="45"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" IsReadOnly="True" Width="55"/>
                                            <DataGridTemplateColumn Header="Color" Width="65">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="36" Height="17" Background="{Binding ColorHex}" BorderBrush="#94A3B8" BorderThickness="1" Cursor="Hand" Click="BtnColorPick_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Label / Class Description" Binding="{Binding Label}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Table Action Buttons (Add/Remove) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Content="➕ Add Class" Style="{StaticResource QgisButton}" Margin="0,0,6,0" Click="BtnAddClass_Click"/>
                                    <Button Content="➖ Remove Class" Style="{StaticResource QgisButton}" Margin="0,0,6,0" Click="BtnRemoveClass_Click"/>
                                    <Button Content="🎲 Shuffle Random" Style="{StaticResource QgisButton}" Click="BtnShuffle_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 1C. Singleband Gray Panel -->
                            <StackPanel x:Name="PanelGray" Visibility="Collapsed">
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Color gradient" Style="{StaticResource QgisParamLabel}"/>
                                    <ComboBox Grid.Column="1" x:Name="ComboGrayGradient" Style="{StaticResource QgisComboBox}"><ComboBoxItem Content="Black to white" IsSelected="True"/><ComboBoxItem Content="White to black"/></ComboBox>
                                </Grid>
                            </StackPanel>

                            <!-- 1D. Singleband Pseudocolor Panel -->
                            <StackPanel x:Name="PanelPseudocolor" Visibility="Collapsed">
                                <TextBlock Text="Styled via selected continuous color ramp." FontSize="10.5" Foreground="#64748B" Margin="100,0,0,4"/>
                            </StackPanel>

                            <!-- 1E. Single Color Panel -->
                            <StackPanel x:Name="PanelSingleColor" Visibility="Collapsed">
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Color" Style="{StaticResource QgisParamLabel}"/>
                                    <Button Grid.Column="1" x:Name="BtnSingleColorPick" Content="Pick Color..." Style="{StaticResource QgisButton}" HorizontalAlignment="Left" Click="BtnSingleColor_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- 1F. Hillshade Panel -->
                            <StackPanel x:Name="PanelHillshade" Visibility="Collapsed">
                                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Altitude" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="1" x:Name="TxtAltitude" Text="45" Style="{StaticResource QgisTextBox}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="Azimuth" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="3" x:Name="TxtAzimuth" Text="315" Style="{StaticResource QgisTextBox}"/>
                                </Grid>
                            </StackPanel>

                            <!-- 1G. Contours Panel -->
                            <StackPanel x:Name="PanelContours" Visibility="Collapsed">
                                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Interval (m)" Style="{StaticResource QgisParamLabel}"/><TextBox Grid.Column="1" x:Name="TxtContourInterval" Text="25" Style="{StaticResource QgisTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 2. LAYER RENDERING SECTION (QGIS Sliders, Blend, Invert) -->
                <Expander Header="Layer Rendering" IsExpanded="True" Style="{StaticResource QgisExpanderHeader}">
                    <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,4,0,8">
                        <StackPanel>
                            <!-- Blending mode & Reset Button -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Blending mode" Style="{StaticResource QgisParamLabel}"/>
                                <ComboBox Grid.Column="1" x:Name="ComboBlendMode" Style="{StaticResource QgisComboBox}" Margin="0,0,8,0" SelectionChanged="ComboBlendMode_SelectionChanged">
                                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                                    <ComboBoxItem Content="Multiply"/><ComboBoxItem Content="Screen"/><ComboBoxItem Content="Overlay"/>
                                    <ComboBoxItem Content="Darken"/><ComboBoxItem Content="Lighten"/><ComboBoxItem Content="Color Dodge"/>
                                    <ComboBoxItem Content="Color Burn"/><ComboBoxItem Content="Hard Light"/><ComboBoxItem Content="Difference"/>
                                    <ComboBoxItem Content="Exclusion"/>
                                </ComboBox>
                                <Button Grid.Column="2" x:Name="BtnResetRendering" Content="⟲ Reset" Style="{StaticResource QgisButton}" Foreground="#D97706" FontWeight="SemiBold" Click="BtnResetRendering_Click"/>
                            </Grid>

                            <!-- Sliders: Brightness & Contrast -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Brightness" Style="{StaticResource QgisParamLabel}"/>
                                    <Slider Grid.Column="1" x:Name="SliderBrightness" Minimum="-100" Maximum="100" Value="0" VerticalAlignment="Center" ValueChanged="SliderBrightness_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="TxtBrightness" Text="{Binding Value, ElementName=SliderBrightness, StringFormat={}{0:F0}}" Style="{StaticResource QgisTextBox}" Margin="4,0,0,0"/>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Contrast" Style="{StaticResource QgisParamLabel}"/>
                                    <Slider Grid.Column="1" x:Name="SliderContrast" Minimum="-100" Maximum="100" Value="0" VerticalAlignment="Center" ValueChanged="SliderContrast_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="TxtContrast" Text="{Binding Value, ElementName=SliderContrast, StringFormat={}{0:F0}}" Style="{StaticResource QgisTextBox}" Margin="4,0,0,0"/>
                                </Grid>
                            </Grid>

                            <!-- Sliders: Gamma & Saturation -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Gamma" Style="{StaticResource QgisParamLabel}"/>
                                    <Slider Grid.Column="1" x:Name="SliderGamma" Minimum="0.1" Maximum="4.0" Value="1.0" SmallChange="0.05" VerticalAlignment="Center" ValueChanged="SliderGamma_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="TxtGamma" Text="{Binding Value, ElementName=SliderGamma, StringFormat={}{0:F2}}" Style="{StaticResource QgisTextBox}" Margin="4,0,0,0"/>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Saturation" Style="{StaticResource QgisParamLabel}"/>
                                    <Slider Grid.Column="1" x:Name="SliderSaturation" Minimum="-100" Maximum="100" Value="0" VerticalAlignment="Center" ValueChanged="SliderSaturation_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="TxtSaturation" Text="{Binding Value, ElementName=SliderSaturation, StringFormat={}{0:F0}}" Style="{StaticResource QgisTextBox}" Margin="4,0,0,0"/>
                                </Grid>
                            </Grid>

                            <!-- Invert & Grayscale -->
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="ChkInvertColors" Content="Invert colors" VerticalAlignment="Center" Margin="0,0,8,0" Click="ChkInvertColors_Click"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Grayscale" Style="{StaticResource QgisParamLabel}"/>
                                    <ComboBox Grid.Column="1" x:Name="ComboGrayscale" Style="{StaticResource QgisComboBox}" SelectionChanged="ComboGrayscale_SelectionChanged">
                                        <ComboBoxItem Content="Off" IsSelected="True"/>
                                        <ComboBoxItem Content="By lightness"/><ComboBoxItem Content="By luminosity"/><ComboBoxItem Content="By average"/>
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 3. RESAMPLING SECTION -->
                <Expander Header="Resampling" IsExpanded="False" Style="{StaticResource QgisExpanderHeader}">
                    <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,4,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Zoomed: in" Style="{StaticResource QgisParamLabel}"/>
                            <ComboBox Grid.Column="1" x:Name="ComboResampleIn" Style="{StaticResource QgisComboBox}" Margin="0,0,8,0">
                                <ComboBoxItem Content="Nearest Neighbour" IsSelected="True"/><ComboBoxItem Content="Bilinear"/><ComboBoxItem Content="Cubic"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="out" Style="{StaticResource QgisParamLabel}"/>
                            <ComboBox Grid.Column="3" x:Name="ComboResampleOut" Style="{StaticResource QgisComboBox}">
                                <ComboBoxItem Content="Nearest Neighbour" IsSelected="True"/><ComboBoxItem Content="Average"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Dialog Footer (QGIS Style) -->
        <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
            <Grid>
                <Button Content="Style ▾" HorizontalAlignment="Left" Style="{StaticResource QgisButton}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Width="75" Margin="0,0,6,0" Style="{StaticResource QgisButton}" FontWeight="SemiBold" Click="BtnOk_Click"/>
                    <Button Content="Cancel" Width="75" Margin="0,0,6,0" Style="{StaticResource QgisButton}" Click="BtnCancel_Click"/>
                    <Button Content="Apply" Width="75" Margin="0,0,6,0" Style="{StaticResource QgisButton}" Click="BtnApply_Click"/>
                    <Button Content="Help" Width="60" Style="{StaticResource QgisButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
