<Window x:Class="GeoStudio.UI.Dialogs.RasterStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="Raster Band Statistics &amp; Histogram"
        Height="540" Width="720" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Component -->
        <components:DialogHeader Grid.Row="0"
            Icon="ℹ" IconBrush="#0284C7" IconBg="#E0F2FE"
            Title="Raster Band Statistics &amp; Histogram"
            Description="Calculates exact Min, Max, Mean, Std Dev, and 256-bin histogram via GDAL."/>

        <!-- 2. Selector Row -->
        <Border Grid.Row="1" Style="{StaticResource DialogCard}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Raster Layer:" Style="{StaticResource DialogParamLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboRaster" Height="30" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Band:" Style="{StaticResource DialogParamLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboBand" Height="30" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1">
                        <ComboBoxItem Content="Band 1" IsSelected="True"/>
                        <ComboBoxItem Content="Band 2"/>
                        <ComboBoxItem Content="Band 3"/>
                        <ComboBoxItem Content="Band 4"/>
                    </ComboBox>
                </StackPanel>
                <Button x:Name="BtnCalculate" Grid.Column="2" Content="Calculate" Width="100" Height="30" VerticalAlignment="Bottom" Style="{StaticResource DialogActionButton}" Background="#0284C7" Click="BtnCalculate_Click"/>
            </Grid>
        </Border>

        <!-- 3. Results: Metrics Grid & Histogram -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- MetricTile Components -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <components:MetricTile x:Name="TxtMin" Grid.Column="0" Label="MINIMUM" Value="--" ValueBrush="#0284C7"/>
                <components:MetricTile x:Name="TxtMax" Grid.Column="1" Label="MAXIMUM" Value="--" ValueBrush="#0284C7"/>
                <components:MetricTile x:Name="TxtMean" Grid.Column="2" Label="MEAN (μ)" Value="--" ValueBrush="#0F172A"/>
                <components:MetricTile x:Name="TxtStdDev" Grid.Column="3" Label="STD DEV (σ)" Value="--" ValueBrush="#0F172A"/>
            </Grid>

            <!-- Histogram Chart & Metadata -->
            <Border Grid.Row="1" Style="{StaticResource DialogCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="256-Bin Pixel Intensity Distribution Histogram" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

                    <!-- Canvas for Histogram -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" ClipToBounds="True">
                        <Canvas x:Name="CanvasHistogram" SizeChanged="CanvasHistogram_SizeChanged"/>
                    </Border>

                    <!-- Details Footer -->
                    <TextBlock x:Name="TxtDetails" Grid.Row="2" Text="Dimensions: -- | Pixel Size: -- | Data Type: --" FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Progress and Close -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressStats" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#0284C7" Margin="0,0,16,0"/>
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="#64748B"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Width="90" Height="32" Style="{StaticResource DialogSecondaryButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
