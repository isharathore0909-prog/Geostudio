<Window x:Class="GeoStudio.UI.Dialogs.TransposeFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transpose / Pivot Fields"
        Height="620" Width="680" MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Info Banner -->
            <RowDefinition Height="Auto"/> <!-- Input Layer -->
            <RowDefinition Height="*"/>    <!-- Field Selection (3 columns) -->
            <RowDefinition Height="Auto"/> <!-- Column Names -->
            <RowDefinition Height="Auto"/> <!-- Output Path -->
            <RowDefinition Height="Auto"/> <!-- Progress / Status -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Info Banner -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Transpose / Pivot Fields (ArcGIS Pro Data Management)" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                <TextBlock Text="Switches data stored in columns into rows (wide → long / normalized format). Selected attributes are unpivoted into individual value records." 
                           TextWrapping="Wrap" FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Input Layer -->
        <GroupBox Grid.Row="1" Header="Input Layer" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Vector Layer:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                <ComboBox x:Name="ComboInputLayer" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectionChanged="ComboInputLayer_SelectionChanged"/>
                <Button x:Name="BtnBrowseInput" Grid.Column="2" Content="Browse File..." Style="{StaticResource MiniButton}" Margin="8,0,0,0" Height="28" Click="BtnBrowseInput_Click"/>
            </Grid>
        </GroupBox>

        <!-- 3. Field Selection -->
        <GroupBox Grid.Row="2" Header="Field Selection" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Available Fields -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Available Fields:" FontSize="11" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,4"/>
                    <ListBox x:Name="ListAvailableFields" Grid.Row="1" SelectionMode="Extended" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"/>
                </Grid>

                <!-- Center: Transfer Buttons -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0">
                    <Button x:Name="BtnAddTranspose" Style="{StaticResource MiniButton}" Width="86" Height="36" Margin="0,0,0,6" Click="BtnAddTranspose_Click" ToolTip="Add selected fields to Fields to Transpose">
                        <TextBlock Text="⇒ Transpose" TextAlignment="Center" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="BtnAddKeep" Style="{StaticResource MiniButton}" Width="86" Height="36" Margin="0,0,0,8" Click="BtnAddKeep_Click" ToolTip="Add selected fields to Keep as IDs">
                        <TextBlock Text="⇒ Keep (ID)" TextAlignment="Center" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="BtnRemoveField" Style="{StaticResource MiniButton}" Width="86" Height="28" Click="BtnRemoveField_Click" ToolTip="Remove selected fields from right lists">
                        <TextBlock Text="⇐ Remove" TextAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Right: Targets -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Fields to Transpose (pivot):" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox x:Name="ListTransposeFields" Grid.Row="1" SelectionMode="Extended" Background="#FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Text="Attribute Fields to Keep (id vars):" FontSize="11" Foreground="#059669" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox x:Name="ListKeepFields" Grid.Row="3" SelectionMode="Extended" Background="#FFFFFF" BorderBrush="#A7F3D0" BorderThickness="1"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 4. Output Column Names -->
        <GroupBox Grid.Row="3" Header="Output Column Names" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Transposed Field Name:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#64748B"/>
                <TextBox x:Name="TxtTransposedFieldName" Grid.Column="1" Text="Attribute" Height="26" VerticalContentAlignment="Center" Padding="4,2"/>

                <TextBlock Grid.Column="3" Text="Value Field Name:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#64748B"/>
                <TextBox x:Name="TxtValueFieldName" Grid.Column="4" Text="Value" Height="26" VerticalContentAlignment="Center" Padding="4,2"/>
            </Grid>
        </GroupBox>

        <!-- 5. Output Path -->
        <GroupBox Grid.Row="4" Header="Output Destination" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Output File:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" Foreground="#64748B"/>
                <TextBox x:Name="TxtOutputPath" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,2"/>
                <Button x:Name="BtnBrowseOutput" Grid.Column="2" Content="Browse..." Style="{StaticResource MiniButton}" Margin="8,0,0,0" Height="26" Click="BtnBrowseOutput_Click"/>
            </Grid>
        </GroupBox>

        <!-- 6. Progress & Status -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <ProgressBar x:Name="ProgressBarTranspose" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="#64748B"/>
        </StackPanel>

        <!-- 7. Action Buttons -->
        <Grid Grid.Row="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRun" Content="▶ Run Transpose Fields" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnRun_Click"/>
                <Button x:Name="BtnClose" Content="Close" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
