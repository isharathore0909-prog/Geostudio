<Window x:Class="GeoStudio.UI.Dialogs.Plugins.PluginInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extension Package Details"
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Icon, Name, Category -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#F1F5F9" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIcon" Text="🧩" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="TxtName" Text="Plugin Name" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                    <TextBlock x:Name="TxtCategory" Text="Category" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" x:Name="BadgeStatus" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Background="#F1F5F9">
                    <TextBlock x:Name="TxtBadge" Text="AVAILABLE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                </Border>
            </Grid>
        </Border>

        <!-- Description & Details -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Description &amp; Tools Included:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtDescription" Text="Detailed description of the plugin capabilities and tools..." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="📦 Download Size: " FontSize="10.5" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtSize" Text="42.0 MB" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,16,0"/>
                    <TextBlock Text="⚙ Engine: " FontSize="10.5" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtEngine" Text="Python Subprocess" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Action Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Open All Plugins..." Height="32" Padding="12,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnOpenAll_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnInstall" Content="📥 Install Plugin" Height="32" Padding="16,0" FontWeight="Bold" FontSize="11" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnInstall_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnUninstall" Content="🗑️ Uninstall" Height="32" Padding="14,0" FontWeight="Bold" FontSize="11" Background="#DC2626" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnUninstall_Click" Margin="0,0,8,0"/>
                <Button Content="Close" Height="32" Padding="14,0" Style="{StaticResource RustGisSmallBtn}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
