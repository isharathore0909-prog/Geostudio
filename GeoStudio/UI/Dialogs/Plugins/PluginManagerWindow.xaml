<Window x:Class="GeoStudio.UI.Dialogs.Plugins.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="GeoStudio Extension Hub" Height="620" Width="820"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Extension &amp; Plugin Hub" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                            <TextBlock Text="100% Offline Native" FontSize="9.5" FontWeight="SemiBold" Foreground="#15803D"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Install or remove specialized GIS modules on demand to keep GeoStudio lightweight." 
                               FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Click="BtnClose_Click" 
                        Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="14" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- 2. Search & Filter Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox x:Name="TxtSearch" Grid.Column="0" Height="30" TextChanged="TxtSearch_TextChanged"
                         Padding="8,4" FontSize="11" VerticalContentAlignment="Center" Background="#F1F5F9" 
                         BorderBrush="#CBD5E1" BorderThickness="1"/>

                <!-- Filter Radio Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <RadioButton x:Name="RadioAll" Content="All Plugins" IsChecked="True" Checked="Filter_Changed" Margin="0,0,12,0" FontSize="11" Foreground="#475569"/>
                    <RadioButton x:Name="RadioInstalled" Content="Installed" Checked="Filter_Changed" Margin="0,0,12,0" FontSize="11" Foreground="#475569"/>
                    <RadioButton x:Name="RadioAvailable" Content="Available" Checked="Filter_Changed" FontSize="11" Foreground="#475569"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Scrollable Cards List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <ItemsControl x:Name="PluginsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <components:PluginCardControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. Footer Bar -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSummary" Text="Loading plugins..." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Done" Width="85" Height="30" Click="BtnClose_Click"
                        Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" FontSize="11.5" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
