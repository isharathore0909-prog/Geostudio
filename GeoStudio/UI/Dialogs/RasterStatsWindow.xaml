<Window x:Class="GeoStudio.UI.Dialogs.RasterStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raster Band Statistics &amp; Histogram"
        Height="540" Width="720" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E0F2FE" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="ℹ" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0284C7"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Raster Band Statistics &amp; Histogram" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Calculates exact Min, Max, Mean, Std Dev, and 256-bin histogram via GDAL." FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Selector Row -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Raster Layer:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboRaster" Height="30" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Band:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboBand" Height="30" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1">
                        <ComboBoxItem Content="Band 1" IsSelected="True"/>
                        <ComboBoxItem Content="Band 2"/>
                        <ComboBoxItem Content="Band 3"/>
                        <ComboBoxItem Content="Band 4"/>
                    </ComboBox>
                </StackPanel>
                <Button x:Name="BtnCalculate" Grid.Column="2" Content="Calculate" Width="100" Height="30" VerticalAlignment="Bottom" Style="{StaticResource ActionButton}" Click="BtnCalculate_Click"/>
            </Grid>
        </Border>

        <!-- Results: Metrics Grid & Histogram -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MINIMUM" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtMin" Text="--" FontSize="16" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MAXIMUM" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtMax" Text="--" FontSize="16" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MEAN (μ)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtMean" Text="--" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="STD DEV (σ)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtStdDev" Text="--" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Histogram Chart & Metadata -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="256-Bin Pixel Intensity Distribution Histogram" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

                    <!-- Canvas for Histogram -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" ClipToBounds="True">
                        <Canvas x:Name="CanvasHistogram" SizeChanged="CanvasHistogram_SizeChanged"/>
                    </Border>

                    <!-- Details Footer -->
                    <TextBlock x:Name="TxtDetails" Grid.Row="2" Text="Dimensions: -- | Pixel Size: -- | Data Type: --" FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress and Close -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressStats" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#0284C7" Margin="0,0,16,0"/>
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="#64748B"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Width="90" Height="32" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
