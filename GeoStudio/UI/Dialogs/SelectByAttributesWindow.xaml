<Window x:Class="GeoStudio.UI.Dialogs.SelectByAttributesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select By Attributes"
        Height="500" Width="510" MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏷️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Select Features By Attributes" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Query and highlight features meeting specified attribute criteria." FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Parameter Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">
                    <!-- Layer Selection -->
                    <TextBlock Text="Target Vector Layer:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbLayers" Height="30" Margin="0,0,0,12" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" SelectionChanged="CmbLayers_SelectionChanged"/>

                    <!-- Attribute Field & Operator -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Attribute Field Name:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbField" IsEditable="True" Height="30" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" SelectionChanged="CmbField_SelectionChanged" TextBoxBase.TextChanged="UpdatePreview_TextChanged"/>
                            <TextBlock x:Name="TxtFieldHint" Text="Pick or type attribute (e.g. MATERIAL, NAME, TYPE)" FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Operator:" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbOperator" Height="30" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" SelectionChanged="CmbOperator_SelectionChanged">
                                <ComboBoxItem Content="=" Tag="=" IsSelected="True"/>
                                <ComboBoxItem Content="!=" Tag="!="/>
                                <ComboBoxItem Content="&gt;" Tag="&gt;"/>
                                <ComboBoxItem Content="&gt;=" Tag="&gt;="/>
                                <ComboBoxItem Content="&lt;" Tag="&lt;"/>
                                <ComboBoxItem Content="&lt;=" Tag="&lt;="/>
                                <ComboBoxItem Content="Contains" Tag="contains"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Query Value -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Value to Match:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBlock Grid.Column="1" x:Name="TxtValueCountHint" Text="" FontSize="10" Foreground="#0284C7"/>
                    </Grid>
                    <ComboBox x:Name="CmbValue" IsEditable="True" Height="30" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" Margin="0,0,0,14" SelectionChanged="CmbValue_SelectionChanged" TextBoxBase.TextChanged="UpdatePreview_TextChanged"/>

                    <!-- Preview Expression Box -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" MinHeight="52">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="SQL Query Expression Preview:" FontSize="10" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtExpressionPreview" Text="WHERE ELEV = 1000" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="🔍 Select Matching Features" Style="{StaticResource ActionButton}" Click="BtnSelect_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
