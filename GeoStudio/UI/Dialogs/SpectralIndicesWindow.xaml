<Window x:Class="GeoStudio.UI.Dialogs.SpectralIndicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multispectral Indices &amp; Remote Sensing"
        Height="620" Width="740" MinHeight="580" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="BandInput" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#065F46"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#ECFDF5" CornerRadius="6" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🛰️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Multispectral Spectral Indices &amp; Composites" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Calculate vegetation, water, urban built-up, burn ratio indices and false-color composites with automatic map canvas integration." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Form Parameters -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <!-- 1. Input Raster -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Input Multispectral Raster Dataset:" Style="{StaticResource ParamLabel}"/>
                        <Border x:Name="BadgeBands" Grid.Column="1" Background="#ECFDF5" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                            <TextBlock x:Name="TxtBandsBadge" Text="✓ Multispectral" FontSize="10" FontWeight="SemiBold" Foreground="#059669"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboRasterLayer" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" SelectionChanged="ComboRasterLayer_SelectionChanged"/>
                        <Button Grid.Column="1" Content="Browse..." Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseRaster_Click"/>
                    </Grid>

                    <!-- 2. Index / Operation Mode -->
                    <TextBlock Text="Spectral Index / Transformation Mode:" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="ComboIndexMode" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="0,0,0,10" SelectionChanged="ComboIndexMode_SelectionChanged">
                        <ComboBoxItem Content="🌿 NDVI — Normalized Difference Vegetation Index" Tag="NDVI" IsSelected="True"/>
                        <ComboBoxItem Content="💧 NDWI — Normalized Difference Water Index (McFeeters)" Tag="NDWI"/>
                        <ComboBoxItem Content="🌾 EVI — Enhanced Vegetation Index (Atmospheric Corrected)" Tag="EVI"/>
                        <ComboBoxItem Content="🏙️ NDBI — Normalized Difference Built-up Index (Urban Extent)" Tag="NDBI"/>
                        <ComboBoxItem Content="🔥 NBR — Normalized Burn Ratio (Wildfire / Burn Severity)" Tag="NBR"/>
                        <ComboBoxItem Content="🎨 False Color Composite — Infrared (NIR / Red / Green)" Tag="FALSE_COLOR"/>
                    </ComboBox>

                    <!-- Formula & Mode Description Card -->
                    <Border x:Name="CardFormulaInfo" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Formula: " FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                <TextBlock x:Name="TxtFormula" Grid.Column="1" Text="(NIR - Red) / (NIR + Red)" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11" Foreground="#059669"/>
                            </Grid>
                            <TextBlock x:Name="TxtModeDesc" Text="Measures vegetation density and health by quantifying the difference between near-infrared (which vegetation strongly reflects) and red light (which vegetation absorbs). Typical values: -1.0 to +1.0." FontSize="10.5" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Sensor Preset -->
                    <TextBlock Text="Satellite / Sensor Band Preset:" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="ComboSensorPreset" Height="30" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="0,0,0,10" SelectionChanged="ComboSensorPreset_SelectionChanged">
                        <ComboBoxItem Content="Sentinel-2 MSI (B8=NIR, B4=Red, B3=Green, B2=Blue, B11=SWIR1, B12=SWIR2)" Tag="sentinel2" IsSelected="True"/>
                        <ComboBoxItem Content="Landsat 8 / 9 OLI (B5=NIR, B4=Red, B3=Green, B2=Blue, B6=SWIR1, B7=SWIR2)" Tag="landsat8"/>
                        <ComboBoxItem Content="Landsat 4 / 5 / 7 TM/ETM+ (B4=NIR, B3=Red, B2=Green, B1=Blue, B5=SWIR1, B7=SWIR2)" Tag="landsat7"/>
                        <ComboBoxItem Content="PlanetScope / 4-Band Drone (B4=NIR, B1=Red, B2=Green, B3=Blue)" Tag="planetscope"/>
                        <ComboBoxItem Content="Custom / Manual Band Numbers" Tag="custom"/>
                    </ComboBox>

                    <!-- Band Channel Mapping Inputs -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Band Channel Mapping (1-based index):" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- NIR -->
                                <StackPanel x:Name="PanelBandNir" Grid.Column="0" Margin="2,0">
                                    <TextBlock Text="NIR (B8/5)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtBandNir" Text="8" Style="{StaticResource BandInput}" TextChanged="BandInput_TextChanged"/>
                                </StackPanel>

                                <!-- Red -->
                                <StackPanel x:Name="PanelBandRed" Grid.Column="1" Margin="2,0">
                                    <TextBlock Text="Red (B4)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtBandRed" Text="4" Style="{StaticResource BandInput}" TextChanged="BandInput_TextChanged"/>
                                </StackPanel>

                                <!-- Green -->
                                <StackPanel x:Name="PanelBandGreen" Grid.Column="2" Margin="2,0">
                                    <TextBlock Text="Green (B3)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtBandGreen" Text="3" Style="{StaticResource BandInput}" TextChanged="BandInput_TextChanged"/>
                                </StackPanel>

                                <!-- Blue -->
                                <StackPanel x:Name="PanelBandBlue" Grid.Column="3" Margin="2,0">
                                    <TextBlock Text="Blue (B2)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtBandBlue" Text="2" Style="{StaticResource BandInput}" TextChanged="BandInput_TextChanged"/>
                                </StackPanel>

                                <!-- SWIR1 -->
                                <StackPanel x:Name="PanelBandSwir1" Grid.Column="4" Margin="2,0">
                                    <TextBlock Text="SWIR1 (B11/6)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtBandSwir1" Text="11" Style="{StaticResource BandInput}" TextChanged="BandInput_TextChanged"/>
                                </StackPanel>

                                <!-- SWIR2 -->
                                <StackPanel x:Name="PanelBandSwir2" Grid.Column="5" Margin="2,0">
                                    <TextBlock Text="SWIR2 (B12/7)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtBandSwir2" Text="12" Style="{StaticResource BandInput}" TextChanged="BandInput_TextChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Output Path -->
                    <TextBlock Text="Output GeoTIFF Dataset:" Style="{StaticResource ParamLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOutputPath" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,0"/>
                        <Button Grid.Column="1" Content="Save As..." Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseOutput_Click"/>
                    </Grid>
                    <TextBlock Text="The output GeoTIFF will be computed with Deflate compression and immediately displayed on the map canvas." FontSize="10" Foreground="#64748B"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Progress and Status -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ProgressBar x:Name="ProgressCalculation" Height="6" Value="0" Maximum="100" Visibility="Collapsed" Foreground="#059669" Background="#E2E8F0" BorderThickness="0"/>
            <TextBlock x:Name="TxtStatus" Text="Ready to calculate spectral index." FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
            <Button x:Name="BtnRunIndex" Grid.Column="2" Content="⚡ Calculate &amp; Add to Map" Padding="16,0" Height="34" Style="{StaticResource ActionButton}" Click="BtnRunIndex_Click"/>
        </Grid>
    </Grid>
</Window>
