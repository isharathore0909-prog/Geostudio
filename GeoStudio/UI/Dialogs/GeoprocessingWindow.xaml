<Window x:Class="GeoStudio.UI.Dialogs.GeoprocessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vector Geoprocessing Analysis"
        Height="500" Width="660" MinHeight="460" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EFF6FF" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderIcon" Text="🌐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Geodesic Buffer Tool" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Creates a geodesic / geometric buffer around vector features using Shapely." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tool Configuration Panel -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <!-- Tool Switcher (tabs/combos) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Operation Mode:" Style="{StaticResource ParamLabel}"/>
                        <ComboBox x:Name="ComboOperation" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" SelectionChanged="ComboOperation_SelectionChanged">
                            <ComboBoxItem Content="Buffer" Tag="buffer"/>
                            <ComboBoxItem Content="Convex Hull" Tag="convex_hull"/>
                            <ComboBoxItem Content="Centroids" Tag="centroids"/>
                            <ComboBoxItem Content="Dissolve" Tag="dissolve"/>
                            <ComboBoxItem Content="Voronoi (Thiessen)" Tag="voronoi"/>
                            <ComboBoxItem Content="Clip Vector" Tag="clip"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Input Vector Layer:" Style="{StaticResource ParamLabel}"/>
                        <ComboBox x:Name="ComboInputLayer" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" SelectionChanged="ComboInputLayer_SelectionChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Buffer Parameters -->
                <StackPanel x:Name="PanelBufferParams" Visibility="Visible" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Buffer Distance:" Style="{StaticResource ParamLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtBufferDistance" Text="100.0" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,0"/>
                                <TextBlock Grid.Column="1" Text="Meters" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#64748B" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Segments:" Style="{StaticResource ParamLabel}"/>
                            <ComboBox x:Name="ComboSegments" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1">
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="16" IsSelected="True"/>
                                <ComboBoxItem Content="32"/>
                                <ComboBoxItem Content="64"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ChkBufferDissolve" Content="Dissolve overlapping result buffers" Margin="0,10,0,0" Foreground="#334155" FontSize="11"/>
                </StackPanel>

                <!-- Convex Hull Parameters -->
                <StackPanel x:Name="PanelConvexHullParams" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="Hull Scope:" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="ComboHullScope" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1">
                        <ComboBoxItem Content="Overall Enclosing Hull (All features combined)" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="Per-Feature Hull (Each feature independently)" Tag="per_feature"/>
                    </ComboBox>
                </StackPanel>

                <!-- Dissolve Parameters -->
                <StackPanel x:Name="PanelDissolveParams" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="Dissolve Field (Group By):" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="ComboDissolveField" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <!-- Clip Parameters -->
                <StackPanel x:Name="PanelClipParams" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Overlay Mask Polygon (Layer or Custom):" Style="{StaticResource ParamLabel}"/>
                        <Border x:Name="BadgeClipMaskStatus" Grid.Column="1" Background="#EFF6FF" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                            <TextBlock x:Name="TxtClipMaskBadge" Text="✓ Custom Drawn on Canvas" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboClipMaskLayer" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" SelectionChanged="ComboClipMaskLayer_SelectionChanged"/>
                        <Button Grid.Column="1" Content="Browse..." Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseClipMask_Click" ToolTip="Browse for polygon GeoJSON, Shapefile, or GeoPackage"/>
                        <Button x:Name="BtnDrawClipPolygon" Grid.Column="2" Content="✏️ Draw Polygon" Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnDrawClipPolygon_Click" ToolTip="Click points on the map canvas to draw custom clipping polygon (double-click to finish)"/>
                    </Grid>
                </StackPanel>

                <!-- Output Path -->
                <TextBlock Text="Output GeoJSON File:" Style="{StaticResource ParamLabel}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOutputPath" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,0"/>
                    <Button Grid.Column="1" Content="Save As..." Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseOutput_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Progress and Status -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ProgressBar x:Name="ProgressGeo" Height="6" Value="0" Maximum="100" Visibility="Collapsed" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0"/>
            <TextBlock x:Name="TxtStatus" Text="Ready to execute algorithm." FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
            <Button x:Name="BtnRun" Grid.Column="2" Content="▶ Run Algorithm" Width="130" Height="34" Style="{StaticResource ActionButton}" Click="BtnRun_Click"/>
        </Grid>
    </Grid>
</Window>
