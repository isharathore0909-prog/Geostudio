<Window x:Class="GeoStudio.UI.Dialogs.ClipRasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop / Clip Raster by Mask"
        Height="460" Width="680" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E11D48"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BE123C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9F1239"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFE4E6" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="✂" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E11D48"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Crop / Clip Raster by Mask" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Subsets raster dataset using vector boundary polygon or bounding box via Python GDAL Warp." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Parameters -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <!-- 1. Input Raster -->
                <TextBlock Text="Input Raster Dataset:" Style="{StaticResource ParamLabel}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComboRasterLayer" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" SelectionChanged="ComboRasterLayer_SelectionChanged"/>
                    <Button Grid.Column="1" Content="Browse..." Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseRaster_Click"/>
                </Grid>

                <!-- 2. Clipping Mask Vector / Manual Drawing -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Clipping Mask (Vector Polygon):" Style="{StaticResource ParamLabel}"/>
                    <Border x:Name="BadgeMaskStatus" Grid.Column="1" Background="#EFF6FF" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                        <TextBlock x:Name="TxtMaskBadge" Text="✓ Custom Drawn on Canvas" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComboMaskLayer" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" SelectionChanged="ComboMaskLayer_SelectionChanged"/>
                    <Button Grid.Column="1" Content="Browse..." Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseMask_Click"/>
                    <Button x:Name="BtnDrawPolygon" Grid.Column="2" Content="✏️ Draw Polygon" Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnDrawPolygon_Click" ToolTip="Click points on the map canvas to draw custom clipping polygon (double-click to finish)"/>
                </Grid>

                <!-- 3. Output Path -->
                <TextBlock Text="Output Clipped GeoTIFF:" Style="{StaticResource ParamLabel}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOutputPath" Height="32" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,0"/>
                    <Button Grid.Column="1" Content="Save As..." Height="32" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseOutput_Click"/>
                </Grid>
                <TextBlock Text="Crop to cutline is automatically enabled; background pixels outside polygon will become NoData transparent." FontSize="10" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Progress and Status -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar x:Name="ProgressClip" Height="6" Value="0" Maximum="100" Visibility="Collapsed" Foreground="#E11D48" Background="#E2E8F0" BorderThickness="0"/>
            <TextBlock x:Name="TxtStatus" Text="Ready to clip raster." FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
            <Button x:Name="BtnRunClip" Grid.Column="2" Content="✂ Run Clip" Width="110" Height="34" Style="{StaticResource ActionButton}" Click="BtnRunClip_Click"/>
        </Grid>
    </Grid>
</Window>
