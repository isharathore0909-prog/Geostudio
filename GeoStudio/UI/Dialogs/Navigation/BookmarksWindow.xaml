<Window x:Class="GeoStudio.UI.Dialogs.BookmarksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="Spatial Bookmarks &amp; Saved Views"
        Height="470" Width="520" MinHeight="400" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Component -->
        <components:DialogHeader Grid.Row="0"
            Icon="🔖" IconBrush="#0284C7" IconBg="#E0F2FE"
            Title="Spatial Bookmarks"
            Description="Quickly navigate to saved geographic regions or save your current map view."/>

        <!-- 2. Bookmarks List -->
        <Border Grid.Row="1" Style="{StaticResource DialogCard}" Padding="2" Margin="0,0,0,12">
            <ListBox x:Name="LstBookmarks" BorderThickness="0" Background="Transparent" MouseDoubleClick="LstBookmarks_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8" Margin="2,1" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding Details}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ZoomText}" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 3. Add Current View Section -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNewBookmarkName" Grid.Column="0" Height="30" VerticalContentAlignment="Center" 
                         Padding="8,0" BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="12"
                         Text="Current Map View" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="➕ Save Current View" Style="{StaticResource DialogActionButton}" Height="30" Background="#0284C7" Click="BtnSaveCurrent_Click"/>
            </Grid>
        </Border>

        <!-- 4. Actions Footer -->
        <Grid Grid.Row="3">
            <Button Content="🗑️ Delete" HorizontalAlignment="Left" Style="{StaticResource DialogSecondaryButton}" Click="BtnDelete_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0" Click="BtnClose_Click"/>
                <Button Content="🚀 Fly To Bookmark" Style="{StaticResource DialogActionButton}" Background="#0284C7" Click="BtnFlyTo_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
