<Window x:Class="GeoStudio.UI.Dialogs.GoToXyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="Go To Coordinates (XY)"
        Height="430" Width="480" MinHeight="380" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Component -->
        <components:DialogHeader Grid.Row="0"
            Icon="🎯" IconBrush="#0284C7" IconBg="#E0F2FE"
            Title="Go To Coordinate Location"
            Description="Enter Longitude &amp; Latitude in Decimal Degrees (WGS84) or paste combined coordinates."/>

        <!-- 2. Inputs Card -->
        <Border Grid.Row="1" Style="{StaticResource DialogCard}" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <!-- Quick Paste Input -->
                <TextBlock Text="Quick Paste (e.g. '27.9881, 86.9250' or '36.1069 -112.1129'):" Style="{StaticResource DialogParamLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtQuickPaste" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1" Margin="0,0,0,12" TextChanged="TxtQuickPaste_TextChanged"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Latitude (Y) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Latitude (Y / North-South):" Style="{StaticResource DialogParamLabel}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLatitude" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1" Text="28.6139"/>
                        <TextBlock Text="-90.0° to +90.0°" FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Longitude (X) -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Longitude (X / East-West):" Style="{StaticResource DialogParamLabel}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLongitude" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1" Text="77.2090"/>
                        <TextBlock Text="-180.0° to +180.0°" FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Target Zoom Level -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Target Zoom Level:" Style="{StaticResource DialogParamLabel}" Margin="0"/>
                    <TextBlock x:Name="TxtZoomVal" Grid.Column="1" Text="14.0x" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                </Grid>
                <Slider x:Name="SliderZoom" Minimum="3" Maximum="20" Value="14" SmallChange="1" LargeChange="2" ValueChanged="SliderZoom_ValueChanged" Margin="0,0,0,12"/>

                <!-- Drop Pin Option -->
                <CheckBox x:Name="ChkDropPin" Content="Drop pinpoint marker at target coordinates" IsChecked="True" FontSize="11.5" Foreground="#334155"/>
            </StackPanel>
        </Border>

        <!-- 3. Footer Actions -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="🎯 Jump To Location" Style="{StaticResource DialogActionButton}" Background="#0284C7" Click="BtnGo_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
