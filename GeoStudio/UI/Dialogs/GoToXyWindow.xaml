<Window x:Class="GeoStudio.UI.Dialogs.GoToXyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go To Coordinates (XY)"
        Height="420" Width="480" MinHeight="380" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎯" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Go To Coordinate Location" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Enter Longitude &amp; Latitude in Decimal Degrees (WGS84) or paste combined coordinates." FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Inputs Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <!-- Quick Paste Input -->
                <TextBlock Text="Quick Paste (e.g. '27.9881, 86.9250' or '36.1069 -112.1129'):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtQuickPaste" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1" Margin="0,0,0,12" TextChanged="TxtQuickPaste_TextChanged"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Latitude (Y) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Latitude (Y / North-South):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLatitude" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1" Text="28.6139"/>
                        <TextBlock Text="-90.0° to +90.0°" FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Longitude (X) -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Longitude (X / East-West):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLongitude" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1" Text="77.2090"/>
                        <TextBlock Text="-180.0° to +180.0°" FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Target Zoom Level -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Target Zoom Level:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="TxtZoomVal" Grid.Column="1" Text="14.0x" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                </Grid>
                <Slider x:Name="SliderZoom" Minimum="3" Maximum="20" Value="14" SmallChange="1" LargeChange="2" ValueChanged="SliderZoom_ValueChanged" Margin="0,0,0,12"/>

                <!-- Drop Pin Option -->
                <CheckBox x:Name="ChkDropPin" Content="Drop pinpoint marker at target coordinates" IsChecked="True" FontSize="11.5" Foreground="#334155"/>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="🎯 Jump To Location" Style="{StaticResource ActionButton}" Click="BtnGo_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
