<Window x:Class="GeoStudio.UI.ContourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="Contour Generator &amp; Isoline Extraction"
        Height="540" Width="660" MinHeight="480" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Component -->
        <components:DialogHeader Grid.Row="0"
            Icon="📈" IconBrush="#0284C7" IconBg="#E0F2FE"
            Title="Extract Elevation Contour Lines"
            Description="Generates standard topographic isocontours from elevation DEM raster grids with vector styling."
            BadgeText="GDAL Isoline Engine"/>

        <!-- 2. Configuration Card -->
        <Border Grid.Row="1" Style="{StaticResource DialogCard}">
            <StackPanel>
                <!-- 1. Source DEM -->
                <TextBlock Text="SOURCE ELEVATION RASTER (DEM)" Style="{StaticResource DialogParamLabel}"/>
                <ComboBox x:Name="ComboSourceRaster" Height="34" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                <!-- 2. Contour Interval -->
                <TextBlock Text="CONTOUR INTERVAL (METERS)" Style="{StaticResource DialogParamLabel}"/>
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="TxtInterval" Height="34" Text="10" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" Padding="10,0,70,0" FontWeight="SemiBold" FontSize="13"/>
                    <Border HorizontalAlignment="Right" Width="60" Height="32" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" CornerRadius="0,2,2,0" Margin="0,0,1,0">
                        <TextBlock Text="meters" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/>
                    </Border>
                </Grid>
                <TextBlock Text="Specifies the vertical elevation step between adjacent isoline contour curves (e.g. 5, 10, 20, 50)." FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

                <!-- 3. Base Elevation & Color -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="BASE ELEVATION (DATUM OFFSET)" Style="{StaticResource DialogParamLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <TextBox x:Name="TxtBaseElev" Height="34" Text="0.0" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" Padding="10,0,70,0" FontSize="13"/>
                            <Border HorizontalAlignment="Right" Width="60" Height="32" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" CornerRadius="0,2,2,0" Margin="0,0,1,0">
                                <TextBlock Text="meters" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Datum reference plane for isoline elevation levels." FontSize="10.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="CONTOUR LINE COLOR" Style="{StaticResource DialogParamLabel}"/>
                        <ComboBox x:Name="ComboContourColor" Height="34" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center">
                            <ComboBoxItem IsSelected="True" Tag="#D97706">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#D97706" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Topographic Amber (#D97706)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#92400E">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#92400E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Deep Bronze (#92400E)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#059669">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#059669" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Emerald Green (#059669)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#0284C7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cyan Blue (#0284C7)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#334155">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#334155" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Charcoal Slate (#334155)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Vector styling applied to generated curves." FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 4. Options -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="ChkZoomToContour" Content="Zoom map to contour layer when ready" IsChecked="True" Foreground="#334155" FontSize="11.5" Margin="0,0,24,0" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="ChkIndexLabels" Content="Render elevation labels along index contours" IsChecked="True" Foreground="#334155" FontSize="11.5" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. Action and Progress Bar Component -->
        <components:ToolActionBar x:Name="ActionBar" Grid.Row="2"
            ActionText="⚡ Generate Contours"
            ActionBackground="#0284C7"
            CancelText="Close"
            StatusText="Ready to extract isocontour lines."
            RunClick="BtnGenerate_Click"
            CancelClick="BtnCancel_Click"/>
    </Grid>
</Window>
