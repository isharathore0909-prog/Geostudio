<Window x:Class="GeoStudio.UI.CutFillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="Earthwork Cut &amp; Fill Volume Analysis"
        Height="450" Width="700" MinHeight="400" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Component -->
        <components:DialogHeader Grid.Row="0"
            Icon="⛏" IconBrush="#D97706" IconBg="#FEF3C7"
            Title="Cut &amp; Fill Earthwork Volume Calculator"
            Description="Calculate excavation, embankment, and net volumetric balance between DEM surfaces or datum plane."/>

        <!-- 2. Surface Selection & Parameters Card -->
        <Border Grid.Row="1" Style="{StaticResource DialogCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Base Surface (Existing):" VerticalAlignment="Center" Style="{StaticResource DialogParamLabel}" Margin="0,6"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboBaseSurface" Height="34" Margin="0,4" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Compare Surface (Design):" VerticalAlignment="Center" Style="{StaticResource DialogParamLabel}" Margin="0,6"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ComboCompSurface" Height="34" Margin="0,4" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="⚡ Calculate Earthwork Volume" Width="220" Height="34" Style="{StaticResource DialogActionButton}" Background="#0284C7" Click="BtnCompute_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Results Summary Card -->
        <Border Grid.Row="2" Style="{StaticResource DialogCard}">
            <StackPanel>
                <TextBlock Text="Earthwork Calculation Results" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtResults" Text="Select base and comparison DEM surfaces and click Calculate." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
        </Border>

        <!-- 4. Bottom Action Bar -->
        <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready to calculate." VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📊 Export Report CSV" Width="160" Height="34" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,10,0" Click="BtnExport_Click"/>
                    <Button Content="Close" Width="90" Height="34" Style="{StaticResource DialogSecondaryButton}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
