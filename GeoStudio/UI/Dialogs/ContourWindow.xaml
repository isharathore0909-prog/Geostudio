<Window x:Class="GeoStudio.UI.ContourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contour Generator &amp; Isoline Extraction"
        Height="520" Width="640" MinHeight="480" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#38BDF8"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📈" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Extract Elevation Contour Lines" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                    <TextBlock Text="Generates standard topographic isocontours from elevation DEM raster grids with vector styling." FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="GDAL Isoline Engine" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                </Border>
            </Grid>
        </Border>

        <!-- Configuration Card -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <!-- 1. Source DEM -->
                <TextBlock Text="SOURCE ELEVATION RASTER (DEM)" Style="{StaticResource ParamLabel}" Margin="0,0,0,6"/>
                <ComboBox x:Name="ComboSourceRaster" Height="32" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,16"/>

                <!-- 2. Contour Interval -->
                <TextBlock Text="CONTOUR INTERVAL (METERS)" Style="{StaticResource ParamLabel}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInterval" Grid.Column="0" Height="32" Text="10" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" VerticalContentAlignment="Center" Padding="8,0" FontWeight="Bold" FontSize="13"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Content="2m" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" Tag="2"/>
                        <Button Content="5m" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" Tag="5"/>
                        <Button Content="10m" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" Tag="10"/>
                        <Button Content="20m" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" Tag="20"/>
                        <Button Content="50m" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" Tag="50"/>
                        <Button Content="100m" Style="{StaticResource PresetButton}" Click="BtnPreset_Click" Tag="100"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Specifies the vertical elevation step between adjacent contour curves." FontSize="10" Foreground="#64748B" Margin="0,0,0,16"/>

                <!-- 3. Base Elevation -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="BASE ELEVATION (DATUM OFFSET)" Style="{StaticResource ParamLabel}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtBaseElev" Height="32" Text="0.0" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="CONTOUR LINE COLOR" Style="{StaticResource ParamLabel}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboContourColor" Height="32" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155">
                            <ComboBoxItem Content="Topographic Amber (#D97706)" IsSelected="True" Tag="#D97706"/>
                            <ComboBoxItem Content="Deep Bronze (#92400E)" Tag="#92400E"/>
                            <ComboBoxItem Content="Emerald Green (#059669)" Tag="#059669"/>
                            <ComboBoxItem Content="Cyan (#0284C7)" Tag="#0284C7"/>
                            <ComboBoxItem Content="Charcoal Slate (#334155)" Tag="#334155"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- 4. Options -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                    <CheckBox x:Name="ChkZoomToContour" Content="Zoom map to contour layer when ready" IsChecked="True" Foreground="#CBD5E1" FontSize="11" Margin="0,0,24,0"/>
                    <CheckBox x:Name="ChkIndexLabels" Content="Render elevation labels along index contours" IsChecked="True" Foreground="#CBD5E1" FontSize="11"/>
                </StackPanel>

                <!-- Status & Progress -->
                <ProgressBar x:Name="ProgressContour" Height="6" Background="#0F172A" Foreground="#38BDF8" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtContourStatus" Text="Ready to extract isocontour lines." FontSize="11" Foreground="#94A3B8"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtSummary" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Close" Width="90" Height="34" Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button x:Name="BtnGenerate" Content="⚡ Generate Contours" Width="160" Height="34" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnGenerate_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
