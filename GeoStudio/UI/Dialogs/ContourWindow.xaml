<Window x:Class="GeoStudio.UI.ContourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contour Generator &amp; Isoline Extraction"
        Height="530" Width="660" MinHeight="480" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📈" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Extract Elevation Contour Lines" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock Text="Generates standard topographic isocontours from elevation DEM raster grids with vector styling." FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="GDAL Isoline Engine" FontSize="10.5" FontWeight="Bold" Foreground="#059669"/>
                </Border>
            </Grid>
        </Border>

        <!-- Configuration Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <!-- 1. Source DEM -->
                <TextBlock Text="SOURCE ELEVATION RASTER (DEM)" Style="{StaticResource ParamLabel}"/>
                <ComboBox x:Name="ComboSourceRaster" Height="34" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                <!-- 2. Contour Interval -->
                <TextBlock Text="CONTOUR INTERVAL (METERS)" Style="{StaticResource ParamLabel}"/>
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="TxtInterval" Height="34" Text="10" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" Padding="10,0,70,0" FontWeight="SemiBold" FontSize="13"/>
                    <Border HorizontalAlignment="Right" Width="60" Height="32" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" CornerRadius="0,2,2,0" Margin="0,0,1,0">
                        <TextBlock Text="meters" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/>
                    </Border>
                </Grid>
                <TextBlock Text="Specifies the vertical elevation step between adjacent isoline contour curves (e.g. 5, 10, 20, 50)." FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

                <!-- 3. Base Elevation & Color -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="BASE ELEVATION (DATUM OFFSET)" Style="{StaticResource ParamLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <TextBox x:Name="TxtBaseElev" Height="34" Text="0.0" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" Padding="10,0,70,0" FontSize="13"/>
                            <Border HorizontalAlignment="Right" Width="60" Height="32" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" CornerRadius="0,2,2,0" Margin="0,0,1,0">
                                <TextBlock Text="meters" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Datum reference plane for isoline elevation levels." FontSize="10.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="CONTOUR LINE COLOR" Style="{StaticResource ParamLabel}"/>
                        <ComboBox x:Name="ComboContourColor" Height="34" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center">
                            <ComboBoxItem IsSelected="True" Tag="#D97706">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#D97706" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Topographic Amber (#D97706)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#92400E">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#92400E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Deep Bronze (#92400E)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#059669">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#059669" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Emerald Green (#059669)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#0284C7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cyan Blue (#0284C7)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#334155">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#334155" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Charcoal Slate (#334155)" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Vector styling applied to generated curves." FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 4. Options -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                    <CheckBox x:Name="ChkZoomToContour" Content="Zoom map to contour layer when ready" IsChecked="True" Foreground="#334155" FontSize="11.5" Margin="0,0,24,0" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="ChkIndexLabels" Content="Render elevation labels along index contours" IsChecked="True" Foreground="#334155" FontSize="11.5" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Status & Progress -->
                <ProgressBar x:Name="ProgressContour" Height="6" Background="#F1F5F9" Foreground="#0284C7" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtContourStatus" Text="Ready to extract isocontour lines." FontSize="11" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtSummary" Grid.Column="0" VerticalAlignment="Center" FontSize="11.5" Foreground="#059669" FontWeight="SemiBold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close" Width="90" Height="34" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnGenerate" Content="⚡ Generate Contours" Width="170" Height="34" Style="{StaticResource ActionButton}" Click="BtnGenerate_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
