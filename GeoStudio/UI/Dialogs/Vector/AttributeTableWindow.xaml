<Window x:Class="GeoStudio.UI.Dialogs.AttributeTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:GeoStudio.UI.Components"
        Title="Attribute Table Inspector"
        Height="560" Width="820" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Row -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Line 1: Title, Layer Selector, Spacer, and Action Buttons (all on identical baseline) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title on Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Vector Attribute Table" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Layer Selector Dropdown -->
                <ComboBox x:Name="CmbTargetLayer" Grid.Column="1" Height="28" MinWidth="180" MaxWidth="320"
                          Margin="12,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Background="#FFFFFF" BorderBrush="#CBD5E1"
                          SelectionChanged="CmbTargetLayer_SelectionChanged"/>

                <!-- Action Buttons on Far Right -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Export CSV" Style="{StaticResource DialogSecondaryButton}" Height="28" Margin="0,0,6,0" Click="BtnExportCsv_Click"/>
                    <Button Content="Zoom to Row" Style="{StaticResource DialogActionButton}" Height="28" Background="#0284C7" Click="BtnZoomToSelectedRow_Click"/>
                </StackPanel>
            </Grid>

            <!-- Line 2: Subtitle Summary -->
            <TextBlock x:Name="TxtLayerSummary" Grid.Row="1" Text="Showing attribute records for active vector layers" FontSize="11.5" Foreground="#64748B" Margin="26,4,0,0"/>
        </Grid>

        <!-- 2. Search Filter Component -->
        <components:SearchBox x:Name="SearchFilter" Grid.Row="1" Margin="0,0,0,10" TextChanged="SearchFilter_TextChanged"/>

        <!-- 3. Data Grid -->
        <Border Grid.Row="2" Style="{StaticResource DialogCard}" Padding="0" Margin="0,0,0,10">
            <DataGrid x:Name="GridAttributes" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent" RowHeaderWidth="0"
                      HorizontalGridLinesBrush="#F1F5F9" FontSize="11.5" RowHeight="28"
                      MouseDoubleClick="GridAttributes_MouseDoubleClick"/>
        </Border>

        <!-- 4. Footer -->
        <Grid Grid.Row="3">
            <TextBlock x:Name="TxtRowCount" Text="0 records loaded" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Content="Close" HorizontalAlignment="Right" Width="90" Height="32" Style="{StaticResource DialogSecondaryButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
