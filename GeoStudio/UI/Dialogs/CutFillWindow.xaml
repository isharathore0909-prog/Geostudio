<Window x:Class="GeoStudio.UI.CutFillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Earthwork Cut &amp; Fill Volume Analysis"
        Height="490" Width="680" MinHeight="420" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="⛏ Cut &amp; Fill Earthwork Volume Calculator" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Calculate excavation, embankment, and net volumetric balance between DEM surfaces or datum plane." FontSize="11" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- Surface Selection & Parameters Card -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Base Surface (Existing):" VerticalAlignment="Center" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboBaseSurface" Height="28" Margin="0,4" Background="#0F172A" Foreground="#F8FAFC"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Compare Surface (Design):" VerticalAlignment="Center" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ComboCompSurface" Height="28" Margin="0,4" Background="#0F172A" Foreground="#F8FAFC"/>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="⚡ Calculate Earthwork Volume" Width="200" Height="30" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCompute_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Result Metrics Grid -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cut Volume -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CUT VOLUME (EXCAVATION)" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                    <TextBlock x:Name="TxtCutVol" Text="0.00 m³" FontSize="17" FontWeight="Bold" Foreground="#F87171" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtCutArea" Text="Area: 0.0 m²" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Fill Volume -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FILL VOLUME (EMBANKMENT)" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock x:Name="TxtFillVol" Text="0.00 m³" FontSize="17" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtFillArea" Text="Area: 0.0 m²" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Net Balance -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NET VOLUME (CUT - FILL)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock x:Name="TxtNetVol" Text="0.00 m³" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtBalanceStatus" Text="Status: Balanced" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Cut / Fill Ratio -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CUT / FILL RATIO" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtRatio" Text="1.000" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Mean Difference -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MEAN THICKNESS (ΔZ)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtMeanThick" Text="0.00 m" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Survey Area -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOTAL OVERLAP AREA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalArea" Text="0.0 ha" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready to calculate." VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📊 Export Report CSV" Width="140" Height="28" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Margin="0,0,8,0" Click="BtnExport_Click"/>
                <Button Content="Close" Width="70" Height="28" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
