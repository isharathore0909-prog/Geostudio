<UserControl x:Class="GeoStudio.UI.Views.Ribbon.LayerRibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- 3. DATA TAB PANEL -->
        <StackPanel x:Name="PanelRibbonData" Orientation="Horizontal" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Vector" Tag="/Resources/Icons/add_vector.png" ToolTip="Load Vector Data (GeoJSON, Shapefile, Geopackage)" Click="BtnAddVector_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Raster / DEM" Tag="/Resources/Icons/add_raster.png" ToolTip="Load 100GB+ BigTIFF, GeoTIFF, DEM" Click="BtnAddRaster_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="LiDAR / LAS" Tag="/Resources/Icons/load_las.png" ToolTip="Load ASPRS LiDAR Point Cloud (LAS / LAZ)" Click="BtnAddLidar_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="CSV Points" Tag="/Resources/Icons/add_csv.png" ToolTip="Load Delimited Text (CSV Points)" Click="BtnAddVector_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Basemap" Tag="/Resources/Icons/add_xyz.png" ToolTip="OpenStreetMap Global Basemap" Click="BtnAddOsm_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Database" Tag="/Resources/Icons/add_wms.png" ToolTip="Spatial Database Connection" Click="BtnDatabase_Click"/>
                </StackPanel>
                <TextBlock Text="Layers" Style="{StaticResource RustGisGroupLabel}"/>
            </StackPanel>

            <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Remove" Tag="/Resources/Icons/delete.png" ToolTip="Remove Selected Layer" Click="MenuRemoveLayer_Click"/>
                </StackPanel>
                <TextBlock Text="Manage" Style="{StaticResource RustGisGroupLabel}"/>
            </StackPanel>
        </StackPanel>

        <!-- Alias for PanelRibbonLayer to maintain compatibility -->
        <StackPanel x:Name="PanelRibbonLayer" Orientation="Horizontal" Visibility="Collapsed"/>

        <!-- 4. STYLE TAB PANEL -->
        <StackPanel x:Name="PanelRibbonStyle" Orientation="Horizontal" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Layer&#x0a;Symbology" ToolTip="Configure Palettes, Classes &amp; Color Ramps (QGIS Style)" Click="BtnRibbonSymbology_Click"/>
                </StackPanel>
                <TextBlock Text="Classification" Style="{StaticResource RustGisGroupLabel}"/>
            </StackPanel>

            <Border Width="1" Background="#E2E8F0" Margin="4,8"/>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="3,0,6,0">
                        <TextBlock Text="Terrain Shader:" FontSize="10" Foreground="#64748B" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ComboShader" Width="110" Style="{StaticResource RustGisComboBox}" SelectionChanged="ComboShader_SelectionChanged">
                            <ComboBoxItem Content="Global Mapper (Atlas)" IsSelected="True"/>
                            <ComboBoxItem Content="Slope Gradient"/>
                            <ComboBoxItem Content="Compass Aspect"/>
                            <ComboBoxItem Content="Monochrome Hillshade"/>
                            <ComboBoxItem Content="Ruggedness (TRI)"/>
                            <ComboBoxItem Content="Topographic Position (TPI)"/>
                            <ComboBoxItem Content="Wetness Index (TWI)"/>
                            <ComboBoxItem Content="Surface Curvature"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="3,0,6,0">
                        <TextBlock Text="Elevation Palette:" FontSize="10" Foreground="#64748B" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ComboAtlas" Width="110" Style="{StaticResource RustGisComboBox}" SelectionChanged="ComboAtlas_SelectionChanged">
                            <ComboBoxItem Content="Atlas (Standard)" IsSelected="True"/>
                            <ComboBoxItem Content="Earth Tones (Terrain)"/>
                            <ComboBoxItem Content="Viridis"/>
                            <ComboBoxItem Content="Magma (High-Contrast)"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Terrain Shaders" Style="{StaticResource RustGisGroupLabel}"/>
            </StackPanel>
        </StackPanel>

        <!-- 5. EDIT TAB PANEL (VECTOR DIGITIZER) -->
        <StackPanel x:Name="PanelRibbonEdit" Orientation="Horizontal" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Toggle&#x0a;Editing" Tag="/Resources/Icons/toggle_edit.png" ToolTip="Toggle Editing Session" Click="BtnToggleEdit_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Add&#x0a;Point" Tag="/Resources/Icons/vertex_tool.png" ToolTip="Digitize Point Feature" Click="BtnDigitizePoint_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Add&#x0a;Line" Tag="/Resources/Icons/digitizer.png" ToolTip="Digitize Polyline Feature" Click="BtnDigitizeLine_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Add&#x0a;Polygon" Tag="/Resources/Icons/select_poly.png" ToolTip="Digitize Polygon Feature" Click="BtnDigitizePolygon_Click"/>
                </StackPanel>
                <TextBlock Text="Create Features" Style="{StaticResource RustGisGroupLabel}"/>
            </StackPanel>

            <Rectangle Width="1" Fill="#E2E8F0" Margin="6,4,6,4" VerticalAlignment="Stretch"/>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Height="68" VerticalAlignment="Center">
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Vertex&#x0a;Tool" Tag="/Resources/Icons/vertex_tool.png" ToolTip="Edit Node Vertices" Click="BtnVertexTool_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Undo&#x0a;Vertex" Tag="/Resources/Icons/undo.png" ToolTip="Undo Last Vertex" Click="BtnUndoVertex_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Delete" Tag="/Resources/Icons/delete.png" ToolTip="Delete Selected Feature" Click="BtnDeleteFeature_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Split" Tag="/Resources/Icons/split.png" ToolTip="Split Feature Geometry" Click="BtnSplitGeometry_Click"/>
                    <Button Style="{StaticResource RustGisLargeBtn}" Content="Clear All" Tag="/Resources/Icons/clear_selection.png" ToolTip="Clear All Digitized Graphics" Click="BtnClearDigitized_Click"/>
                </StackPanel>
                <TextBlock Text="Modify" Style="{StaticResource RustGisGroupLabel}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
